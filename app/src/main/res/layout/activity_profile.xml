<?xml version="1.0" encoding="utf-8"?>
<!-- 15 Profile -->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/white"
    tools:context=".ProfileActivity">

    <!-- Toolbar -->
    <LinearLayout
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="8dp"
        android:paddingEnd="16dp">

        <ImageButton
            android:id="@+id/profileBackBtn"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@android:color/transparent"
            android:contentDescription="Back"
            android:src="@drawable/k_ic_back"
            app:tint="@color/k_text_primary" />

        <TextView
            android:id="@+id/profileTitleName"
            style="@style/Kinnect.Text.ToolbarTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="4dp"
            android:maxLines="1"
            android:ellipsize="end"
            android:text="Jacob West"
            android:textSize="20sp" />

        <ImageView
            android:id="@+id/profileSearchBtn"
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:src="@drawable/k_ic_search"
            android:contentDescription="Search"
            app:tint="@color/k_text_primary" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/k_divider" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="24dp">

            <!-- Cover photo -->
            <ImageView
                android:id="@+id/profileCoverImage"
                android:layout_width="match_parent"
                android:layout_height="180dp"
                android:scaleType="centerCrop"
                android:src="@drawable/people_scene_cover_light"
                android:contentDescription="Cover photo" />

            <!-- Round camera button sitting on the cover's bottom-right (negative margin). -->
            <ImageView
                android:id="@+id/profileCoverCameraBtn"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_gravity="end"
                android:layout_marginTop="-46dp"
                android:layout_marginEnd="16dp"
                android:background="@drawable/k_bg_circle_gray"
                android:padding="9dp"
                android:src="@drawable/k_ic_camera"
                android:contentDescription="Edit cover photo"
                app:tint="@color/k_text_primary" />

            <!-- Avatar with white ring overlapping the cover (negative margin). -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginTop="-63dp"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="138dp"
                    android:layout_height="138dp"
                    android:background="@drawable/k_bg_circle_white"
                    android:padding="4dp">

                    <ImageView
                        android:id="@+id/profileAvatarImage"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:scaleType="centerCrop"
                        android:background="@drawable/k_bg_circle_teal"
                        android:contentDescription="Profile picture"
                        android:visibility="gone" />

                    <TextView
                        android:id="@+id/profileAvatar"
                        style="@style/Kinnect.Text.AvatarInitials"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@drawable/k_bg_circle_teal"
                        android:text="JW"
                        android:textSize="48sp" />
                </LinearLayout>

                <!-- Small camera button on the avatar's bottom-right (negative margin). -->
                <ImageView
                    android:id="@+id/profileAvatarCameraBtn"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:layout_gravity="bottom"
                    android:layout_marginStart="-38dp"
                    android:layout_marginBottom="6dp"
                    android:background="@drawable/k_bg_circle_gray"
                    android:padding="8dp"
                    android:src="@drawable/k_ic_camera"
                    android:contentDescription="Edit profile picture"
                    app:tint="@color/k_text_primary" />
            </LinearLayout>

            <!-- Name, friends, bio -->
            <TextView
                android:id="@+id/profileNameTxt"
                style="@style/Kinnect.Text.PageTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="16dp"
                android:layout_marginTop="12dp"
                android:text="Jacob West" />

            <TextView
                android:id="@+id/profileFriendsCountTxt"
                style="@style/Kinnect.Text.Secondary"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="16dp"
                android:layout_marginTop="8dp"
                android:text="834 friends"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/profileBioTxt"
                style="@style/Kinnect.Text.Body"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="16dp"
                android:layout_marginTop="8dp"
                android:text="Digital goodies designer. Everything is designed."
                android:textSize="15sp" />

            <!-- Add to story / Edit profile / more -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="38dp"
                android:layout_marginHorizontal="16dp"
                android:layout_marginTop="12dp"
                android:orientation="horizontal">

                <LinearLayout
                    android:id="@+id/addToStoryBtn"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:orientation="horizontal"
                    android:gravity="center"
                    android:clickable="true"
                    android:focusable="true"
                    android:background="@drawable/k_bg_button_teal_small">

                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:src="@drawable/k_ic_plus"
                        android:contentDescription="Add"
                        app:tint="@color/white" />

                    <TextView
                        style="@style/Kinnect.Text"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:text="Add to story"
                        android:textColor="@color/white"
                        android:textSize="15sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/editProfileBtn"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:layout_marginStart="8dp"
                    android:orientation="horizontal"
                    android:gravity="center"
                    android:clickable="true"
                    android:focusable="true"
                    android:background="@drawable/k_bg_button_gray">

                    <ImageView
                        android:layout_width="17dp"
                        android:layout_height="17dp"
                        android:src="@drawable/k_ic_pencil"
                        android:contentDescription="Edit"
                        app:tint="@color/k_text_primary" />

                    <TextView
                        style="@style/Kinnect.Text"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:text="Edit profile"
                        android:textSize="15sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <ImageView
                    android:id="@+id/profileMoreBtn"
                    android:layout_width="42dp"
                    android:layout_height="match_parent"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/k_bg_button_gray"
                    android:padding="10dp"
                    android:src="@drawable/k_ic_more"
                    android:contentDescription="More"
                    app:tint="@color/k_text_primary" />
            </LinearLayout>

            <!-- Tabs: Posts (selected) / Photos / Videos / Groups -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="16dp"
                android:layout_marginTop="12dp"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    style="@style/Kinnect.Chip.Selected"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:text="Posts"
                    android:textSize="14sp" />

                <TextView
                    style="@style/Kinnect.Text.Secondary"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingHorizontal="14dp"
                    android:paddingVertical="10dp"
                    android:layout_marginStart="6dp"
                    android:text="Photos"
                    android:textStyle="bold" />

                <TextView
                    style="@style/Kinnect.Text.Secondary"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingHorizontal="14dp"
                    android:paddingVertical="10dp"
                    android:layout_marginStart="6dp"
                    android:text="Videos"
                    android:textStyle="bold" />

                <TextView
                    style="@style/Kinnect.Text.Secondary"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingHorizontal="14dp"
                    android:paddingVertical="10dp"
                    android:layout_marginStart="6dp"
                    android:text="Groups"
                    android:textStyle="bold" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginHorizontal="16dp"
                android:layout_marginTop="8dp"
                android:background="@color/k_divider" />

            <!-- Details -->
            <TextView
                style="@style/Kinnect.Text.Section"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginTop="14dp"
                android:fontFamily="sans-serif-black"
                android:text="Details" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="16dp"
                android:layout_marginTop="12dp"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/k_ic_briefcase"
                    android:contentDescription="Work"
                    app:tint="@color/k_text_primary" />

                <TextView
                    style="@style/Kinnect.Text.Body"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:text="Designer at "
                    android:textSize="15sp" />

                <TextView
                    style="@style/Kinnect.Text.Body"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Pixsellz"
                    android:textSize="15sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="16dp"
                android:layout_marginTop="10dp"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/k_ic_education"
                    android:contentDescription="Education"
                    app:tint="@color/k_text_primary" />

                <TextView
                    style="@style/Kinnect.Text.Body"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:text="Studied at "
                    android:textSize="15sp" />

                <TextView
                    style="@style/Kinnect.Text.Body"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="FAST-NUCES"
                    android:textSize="15sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="16dp"
                android:layout_marginTop="10dp"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/k_ic_location"
                    android:contentDescription="Location"
                    app:tint="@color/k_text_primary" />

                <TextView
                    style="@style/Kinnect.Text.Body"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:text="Lives in "
                    android:textSize="15sp" />

                <TextView
                    style="@style/Kinnect.Text.Body"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Karachi, Pakistan"
                    android:textSize="15sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="16dp"
                android:layout_marginTop="10dp"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/k_ic_clock"
                    android:contentDescription="Joined"
                    app:tint="@color/k_text_primary" />

                <TextView
                    style="@style/Kinnect.Text.Body"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:text="Joined March 2019"
                    android:textSize="15sp" />
            </LinearLayout>

            <!-- Friends -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="16dp"
                android:layout_marginTop="18dp"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        style="@style/Kinnect.Text.Section"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-black"
                        android:text="Friends" />

                    <TextView
                        android:id="@+id/profileFriendsSectionCountTxt"
                        style="@style/Kinnect.Text.Secondary"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="834 friends" />
                </LinearLayout>

                <TextView
                    android:id="@+id/findFriendsBtn"
                    style="@style/Kinnect.Text.Link"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Find friends"
                    android:textSize="15sp" />
            </LinearLayout>

            <!-- Three rounded initials tiles -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="16dp"
                android:layout_marginTop="12dp"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        style="@style/Kinnect.Text.AvatarInitials"
                        android:layout_width="match_parent"
                        android:layout_height="102dp"
                        android:background="@drawable/people_bg_tile_purple"
                        android:text="LM"
                        android:textSize="30sp" />

                    <TextView
                        style="@style/Kinnect.Text"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="Lina Marsh"
                        android:textSize="14sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="10dp"
                    android:orientation="vertical">

                    <TextView
                        style="@style/Kinnect.Text.AvatarInitials"
                        android:layout_width="match_parent"
                        android:layout_height="102dp"
                        android:background="@drawable/people_bg_tile_maroon"
                        android:text="AK"
                        android:textSize="30sp" />

                    <TextView
                        style="@style/Kinnect.Text"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="Aisha Khan"
                        android:textSize="14sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="10dp"
                    android:orientation="vertical">

                    <TextView
                        style="@style/Kinnect.Text.AvatarInitials"
                        android:layout_width="match_parent"
                        android:layout_height="102dp"
                        android:background="@drawable/people_bg_tile_green"
                        android:text="OF"
                        android:textSize="30sp" />

                    <TextView
                        style="@style/Kinnect.Text"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="Omar Farooq"
                        android:textSize="14sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
