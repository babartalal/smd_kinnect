<?xml version="1.0" encoding="utf-8"?>
<!-- 06 · Comments -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    android:orientation="vertical"
    tools:context=".CommentsActivity">

    <LinearLayout
        android:id="@+id/fixedTopCommentSection"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/white"
        android:orientation="vertical">

        <!-- Toolbar: back, title, sort chip -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="6dp"
            android:paddingEnd="16dp">

            <ImageButton
                android:id="@+id/commentSectionBackBtn"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@color/transparent"
                android:contentDescription="Back"
                android:padding="10dp"
                android:scaleType="fitCenter"
                android:src="@drawable/k_ic_back"
                app:tint="@color/k_text_primary" />

            <TextView
                style="@style/Kinnect.Text.ToolbarTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:layout_weight="1"
                android:text="Comments" />

            <LinearLayout
                android:id="@+id/commentSortChip"
                android:layout_width="wrap_content"
                android:layout_height="34dp"
                android:background="@drawable/k_bg_pill_gray"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="14dp"
                android:paddingEnd="10dp">

                <TextView
                    style="@style/Kinnect.Text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Most relevant"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:layout_marginStart="4dp"
                    android:contentDescription="Sort"
                    android:src="@drawable/k_ic_chevron_down"
                    app:tint="@color/k_text_primary" />
            </LinearLayout>
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/k_divider" />

        <!-- Reactions summary -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="42dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:paddingEnd="14dp">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:background="@drawable/k_bg_circle_white"
                android:contentDescription="Like"
                android:padding="1.5dp"
                android:src="@drawable/feed_reaction_like" />

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_marginStart="-6dp"
                android:background="@drawable/k_bg_circle_white"
                android:contentDescription="Love"
                android:padding="1.5dp"
                android:src="@drawable/feed_reaction_love" />

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_marginStart="-6dp"
                android:background="@drawable/k_bg_circle_white"
                android:contentDescription="Haha"
                android:padding="1.5dp"
                android:src="@drawable/feed_reaction_haha" />

            <TextView
                android:id="@+id/commentTotalCountTxt"
                style="@style/Kinnect.Text"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:text="1.2K"
                android:textSize="14sp"
                android:textStyle="bold" />

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:contentDescription="See reactions"
                android:src="@drawable/k_ic_chevron_right"
                app:tint="@color/k_text_secondary" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/k_divider" />
    </LinearLayout>

    <!-- Threaded comments -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/commentsRecyclerView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="@color/white"
        android:clipToPadding="false"
        android:paddingTop="6dp"
        android:paddingBottom="6dp" />

    <LinearLayout
        android:id="@+id/fixedFooterCommentSection"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/white"
        android:orientation="vertical">

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/k_divider" />

        <!-- "Replying to <name>   Cancel" (shown while replying) -->
        <LinearLayout
            android:id="@+id/replyingToBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:paddingTop="10dp"
            android:paddingEnd="16dp"
            android:paddingBottom="2dp"
            android:visibility="gone">

            <TextView
                style="@style/Kinnect.Text.Secondary"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Replying to " />

            <TextView
                android:id="@+id/replyingToAuthorTxt"
                style="@style/Kinnect.Text"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="Aisha Khan"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/cancelReplyBtn"
                style="@style/Kinnect.Text.Secondary"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:clickable="true"
                android:focusable="true"
                android:paddingStart="12dp"
                android:text="Cancel"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Input row: camera, pill input with emoji, round send button -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="8dp"
            android:paddingTop="8dp"
            android:paddingEnd="12dp"
            android:paddingBottom="10dp">

            <ImageButton
                android:id="@+id/commentAttachPhotoBtn"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@color/transparent"
                android:contentDescription="Attach photo"
                android:padding="10dp"
                android:scaleType="fitCenter"
                android:src="@drawable/k_ic_camera"
                app:tint="@color/primary_teal" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="2dp"
                android:layout_weight="1"
                android:background="@drawable/k_bg_pill_gray"
                android:gravity="center_vertical"
                android:minHeight="42dp"
                android:orientation="horizontal"
                android:paddingStart="16dp"
                android:paddingEnd="10dp">

                <EditText
                    android:id="@+id/commentInputText"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="@color/transparent"
                    android:hint="Write a reply..."
                    android:importantForAutofill="no"
                    android:inputType="textCapSentences|textMultiLine"
                    android:maxLines="4"
                    android:paddingTop="10dp"
                    android:paddingBottom="10dp"
                    android:textColor="@color/k_text_primary"
                    android:textColorHint="@color/k_text_hint"
                    android:textSize="16sp" />

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_marginStart="6dp"
                    android:contentDescription="Emoji"
                    android:src="@drawable/k_ic_smile"
                    app:tint="@color/k_text_secondary" />
            </LinearLayout>

            <ImageButton
                android:id="@+id/commentSendBtn"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/k_bg_circle_teal"
                android:contentDescription="Send"
                android:padding="11dp"
                android:scaleType="fitCenter"
                android:src="@drawable/k_ic_send"
                app:tint="@color/white" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
