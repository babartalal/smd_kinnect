<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_warm_offwhite"
    tools:context=".ChatActivity">

    <!-- Top Bar -->
    <LinearLayout
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="@color/white"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="12dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:id="@+id/chatBackBtn"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="@color/transparent"
            android:contentDescription="Back"
            android:padding="6dp"
            android:src="@drawable/rounded_arrow_back_ios_24"
            app:tint="@color/text_dark" />

        <FrameLayout
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_marginStart="6dp">

            <TextView
                android:id="@+id/chatRecipientAvatar"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:background="@drawable/bg_circle_teal"
                android:backgroundTint="@color/accent_rust"
                android:gravity="center"
                android:text="U"
                android:textColor="@color/white"
                android:textSize="12sp"
                android:textStyle="bold" />

            <View
                android:id="@+id/chatRecipientOnlineDot"
                android:layout_width="10dp"
                android:layout_height="10dp"
                android:layout_gravity="bottom|end"
                android:background="@drawable/bg_circle_online"
                android:visibility="gone" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/chatRecipientNameTxt"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Chat User"
                android:textColor="@color/text_dark"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/chatStatusTxt"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Offline"
                android:textColor="@color/text_gray"
                android:textSize="11sp" />
        </LinearLayout>

        <ImageView
            android:id="@+id/voiceCallBtn"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="@drawable/bg_pill_gray"
            android:contentDescription="Call"
            android:padding="8dp"
            android:src="@drawable/outline_bolt_24"
            app:tint="@color/primary_teal" />

        <ImageView
            android:id="@+id/videoCallBtn"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_pill_gray"
            android:contentDescription="Video"
            android:padding="8dp"
            android:src="@drawable/outline_camera_roll_24"
            app:tint="@color/primary_teal" />

        <ImageView
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_pill_gray"
            android:contentDescription="Info"
            android:padding="8dp"
            android:src="@drawable/outline_circle_24"
            app:tint="@color/primary_teal" />
    </LinearLayout>

    <View
        android:id="@+id/headerDivider"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#E0DDD7"
        app:layout_constraintTop_toBottomOf="@id/topBar" />

    <!-- Replying Bar -->
    <LinearLayout
        android:id="@+id/replyingToMessageBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp"
        android:paddingVertical="6dp"
        android:background="#F0F2F5"
        android:visibility="gone"
        app:layout_constraintBottom_toTopOf="@id/bottomInputBar">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Replying: "
            android:textColor="@color/text_gray"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/replyingMsgPreviewTxt"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Message preview"
            android:textColor="@color/primary_teal"
            android:textSize="12sp"
            android:maxLines="1"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/cancelMessageReplyBtn"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Cancel"
            android:textColor="@color/text_gray"
            android:textStyle="bold"
            android:textSize="12sp"
            android:clickable="true"
            android:focusable="true" />
    </LinearLayout>

    <!-- Bottom Input Bar -->
    <LinearLayout
        android:id="@+id/bottomInputBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/white"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="10dp"
        android:paddingVertical="8dp"
        app:layout_constraintBottom_toBottomOf="parent">

        <ImageView
            android:id="@+id/chatCameraBtn"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:contentDescription="Camera"
            android:padding="6dp"
            android:src="@drawable/outline_photo_camera_24"
            app:tint="@color/primary_teal" />

        <ImageView
            android:id="@+id/chatGalleryBtn"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_marginStart="2dp"
            android:contentDescription="Gallery"
            android:padding="6dp"
            android:src="@drawable/outline_image_24"
            app:tint="@color/primary_teal" />

        <!-- Input Box -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_marginStart="6dp"
            android:layout_marginEnd="6dp"
            android:layout_weight="1"
            android:background="@drawable/bg_pill_gray"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="12dp">

            <EditText
                android:id="@+id/chatMessageInput"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@null"
                android:hint="Type a message..."
                android:textColor="@color/text_dark"
                android:textColorHint="@color/text_gray"
                android:textSize="14sp" />
        </LinearLayout>

        <ImageView
            android:id="@+id/chatSendBtn"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:contentDescription="Send"
            android:padding="6dp"
            android:src="@drawable/outline_send_24"
            app:tint="@color/primary_teal" />
    </LinearLayout>

    <!-- Dynamic Messages RecyclerView -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/messagesRecyclerView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:paddingHorizontal="12dp"
        android:paddingVertical="8dp"
        app:layout_constraintTop_toBottomOf="@id/headerDivider"
        app:layout_constraintBottom_toTopOf="@id/replyingToMessageBar" />

</androidx.constraintlayout.widget.ConstraintLayout>