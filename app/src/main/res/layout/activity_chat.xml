<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_warm_offwhite"
    tools:context=".ChatActivity">

    <!-- Top Bar -->
    <LinearLayout
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="@color/white"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="12dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:id="@+id/chatBackBtn"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="@color/transparent"
            android:contentDescription="Back"
            android:padding="6dp"
            android:src="@drawable/rounded_arrow_back_ios_24"
            app:tint="@color/text_dark" />

        <FrameLayout
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_marginStart="6dp">

            <TextView
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:background="@drawable/bg_circle_teal"
                android:backgroundTint="@color/accent_rust"
                android:gravity="center"
                android:text="AK"
                android:textColor="@color/white"
                android:textSize="12sp"
                android:textStyle="bold" />

            <View
                android:layout_width="10dp"
                android:layout_height="10dp"
                android:layout_gravity="bottom|end"
                android:background="@drawable/bg_circle_online" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Aisha Khan"
                android:textColor="@color/text_dark"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Active now"
                android:textColor="@color/text_gray"
                android:textSize="11sp" />
        </LinearLayout>

        <ImageView
            android:id="@+id/voiceCallBtn"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="@drawable/bg_pill_gray"
            android:contentDescription="Call"
            android:padding="8dp"
            android:src="@drawable/outline_bolt_24"
            app:tint="@color/primary_teal" />

        <ImageView
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_pill_gray"
            android:contentDescription="Video"
            android:padding="8dp"
            android:src="@drawable/outline_camera_roll_24"
            app:tint="@color/primary_teal" />

        <ImageView
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_pill_gray"
            android:contentDescription="Info"
            android:padding="8dp"
            android:src="@drawable/outline_circle_24"
            app:tint="@color/primary_teal" />
    </LinearLayout>

    <View
        android:id="@+id/headerDivider"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#E0DDD7"
        app:layout_constraintTop_toBottomOf="@id/topBar" />

    <!-- Scrollable Chat Messages Area -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintBottom_toTopOf="@id/bottomInputBar"
        app:layout_constraintTop_toBottomOf="@id/headerDivider">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="16dp"
            android:paddingVertical="16dp">

            <!-- Profile Summary Card Inside Chat -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:background="@color/white"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:layout_width="72dp"
                    android:layout_height="72dp"
                    android:background="@drawable/bg_circle_teal"
                    android:backgroundTint="@color/accent_rust"
                    android:gravity="center"
                    android:text="AK"
                    android:textColor="@color/white"
                    android:textSize="22sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="Aisha Khan"
                    android:textColor="@color/text_dark"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="You're friends on Kinnect · Lives in Karachi"
                    android:textColor="@color/text_gray"
                    android:textSize="12sp" />
            </LinearLayout>

            <!-- Date Divider -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginVertical="12dp"
                android:text="TODAY 4:49 PM"
                android:textColor="@color/text_gray"
                android:textSize="11sp"
                android:textStyle="bold" />

            <!-- Incoming Message 1 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginVertical="4dp"
                android:gravity="start"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:layout_marginEnd="8dp"
                    android:background="@drawable/bg_circle_teal"
                    android:backgroundTint="@color/accent_rust"
                    android:gravity="center"
                    android:text="AK"
                    android:textColor="@color/white"
                    android:textSize="10sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_chat_incoming"
                    android:paddingHorizontal="14dp"
                    android:paddingVertical="10dp"
                    android:text="Hey! Are you still coming Saturday?"
                    android:textColor="@color/text_dark"
                    android:textSize="14sp" />
            </LinearLayout>

            <!-- Incoming Message 2 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginVertical="4dp"
                android:gravity="start"
                android:orientation="horizontal"
                android:paddingStart="36dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_chat_incoming"
                    android:paddingHorizontal="14dp"
                    android:paddingVertical="10dp"
                    android:text="Lina booked the table for 8"
                    android:textColor="@color/text_dark"
                    android:textSize="14sp" />
            </LinearLayout>

            <!-- Incoming Message 3 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginVertical="4dp"
                android:gravity="start"
                android:orientation="horizontal"
                android:paddingStart="36dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_chat_incoming"
                    android:paddingHorizontal="14dp"
                    android:paddingVertical="10dp"
                    android:text="Bring the camera"
                    android:textColor="@color/text_dark"
                    android:textSize="14sp" />
            </LinearLayout>

            <!-- Outgoing Message 1 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginVertical="4dp"
                android:gravity="end"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_chat_outgoing"
                    android:paddingHorizontal="14dp"
                    android:paddingVertical="10dp"
                    android:text="Yes, obviously"
                    android:textColor="@color/white"
                    android:textSize="14sp" />
            </LinearLayout>

            <!-- Outgoing Message 2 with Heart Reaction Badge -->
            <FrameLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="end"
                android:layout_marginVertical="4dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_chat_outgoing"
                    android:paddingHorizontal="14dp"
                    android:paddingVertical="10dp"
                    android:text="Already charged both batteries"
                    android:textColor="@color/white"
                    android:textSize="14sp" />

                <TextView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_gravity="bottom|start"
                    android:layout_marginStart="-6dp"
                    android:layout_marginBottom="-6dp"
                    android:background="@drawable/bg_circle_teal"
                    android:gravity="center"
                    android:text="❤️"
                    android:textSize="10sp" />
            </FrameLayout>

            <!-- Reply Reference Bubble & Outgoing Message -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginVertical="6dp"
                android:gravity="end"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="2dp"
                    android:text="You replied to Aisha"
                    android:textColor="@color/text_gray"
                    android:textSize="11sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="4dp"
                    android:background="@drawable/bg_comment_rounded"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="6dp"
                    android:text="Lina booked the table for 8"
                    android:textColor="@color/text_dark"
                    android:textSize="12sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_chat_outgoing"
                    android:paddingHorizontal="14dp"
                    android:paddingVertical="10dp"
                    android:text="Perfect, I'll be there by 7:45"
                    android:textColor="@color/white"
                    android:textSize="14sp" />
            </LinearLayout>

            <!-- Photo Attachment Bubble -->
            <FrameLayout
                android:layout_width="200dp"
                android:layout_height="120dp"
                android:layout_gravity="end"
                android:layout_marginVertical="6dp"
                android:background="#A594B8" />

            <!-- Typing Indicator Bubble -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginVertical="4dp"
                android:gravity="start"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:layout_marginEnd="8dp"
                    android:background="@drawable/bg_circle_teal"
                    android:backgroundTint="@color/accent_rust"
                    android:gravity="center"
                    android:text="AK"
                    android:textColor="@color/white"
                    android:textSize="10sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_chat_incoming"
                    android:paddingHorizontal="14dp"
                    android:paddingVertical="10dp"
                    android:text="•••"
                    android:textColor="@color/text_gray"
                    android:textSize="14sp"
                    android:textStyle="bold" />
            </LinearLayout>

        </LinearLayout>
    </ScrollView>

    <!-- Bottom Input Bar -->
    <LinearLayout
        android:id="@+id/bottomInputBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/white"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="10dp"
        android:paddingVertical="8dp"
        app:layout_constraintBottom_toBottomOf="parent">

        <ImageView
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:contentDescription="Plus"
            android:padding="6dp"
            android:src="@drawable/outline_add_2_24"
            app:tint="@color/primary_teal" />

        <ImageView
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_marginStart="2dp"
            android:contentDescription="Camera"
            android:padding="6dp"
            android:src="@drawable/outline_photo_camera_24"
            app:tint="@color/primary_teal" />

        <ImageView
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_marginStart="2dp"
            android:contentDescription="Gallery"
            android:padding="6dp"
            android:src="@drawable/outline_image_24"
            app:tint="@color/primary_teal" />

        <ImageView
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_marginStart="2dp"
            android:contentDescription="Mic"
            android:padding="6dp"
            android:src="@drawable/outline_bolt_24"
            app:tint="@color/primary_teal" />

        <!-- Input Box -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_marginStart="6dp"
            android:layout_marginEnd="6dp"
            android:layout_weight="1"
            android:background="@drawable/bg_pill_gray"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="12dp">

            <EditText
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@null"
                android:hint="Aa"
                android:textColor="@color/text_dark"
                android:textColorHint="@color/text_gray"
                android:textSize="14sp" />

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:contentDescription="Emoji"
                android:src="@drawable/outline_sentiment_very_satisfied_24"
                app:tint="@color/text_gray" />
        </LinearLayout>

        <ImageView
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:contentDescription="Like"
            android:padding="6dp"
            android:src="@drawable/outline_hand_bones_24"
            app:tint="@color/primary_teal" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>