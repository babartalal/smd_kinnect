<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    android:orientation="vertical"
    tools:context=".ChatActivity">

    <!-- Header: back, avatar with online dot, name + status, call / video / info -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:baselineAligned="false"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="8dp"
        android:paddingTop="8dp"
        android:paddingEnd="8dp"
        android:paddingBottom="8dp">

        <ImageView
            android:id="@+id/chatBackBtn"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="Back"
            android:padding="6dp"
            android:src="@drawable/k_ic_back"
            app:tint="@color/primary_teal" />

        <!-- online dot overlaps the avatar's bottom-right corner (negative margin) -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:baselineAligned="false"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/chatRecipientAvatar"
                style="@style/Kinnect.Text.AvatarInitials"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:background="@drawable/k_bg_circle_maroon"
                android:text="U"
                android:textSize="13sp" />

            <View
                android:id="@+id/chatRecipientOnlineDot"
                android:layout_width="12dp"
                android:layout_height="12dp"
                android:layout_gravity="bottom"
                android:layout_marginStart="-12dp"
                android:background="@drawable/k_bg_online_dot"
                android:visibility="gone" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/chatRecipientNameTxt"
                style="@style/Kinnect.Text.Name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="Chat User"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/chatStatusTxt"
                style="@style/Kinnect.Text.Secondary"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="Offline"
                android:textSize="13sp" />
        </LinearLayout>

        <ImageView
            android:id="@+id/voiceCallBtn"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="Voice call"
            android:padding="8dp"
            android:src="@drawable/k_ic_phone"
            app:tint="@color/primary_teal" />

        <ImageView
            android:id="@+id/videoCallBtn"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="Video call"
            android:padding="8dp"
            android:src="@drawable/k_ic_video"
            app:tint="@color/primary_teal" />

        <ImageView
            android:id="@+id/chatInfoBtn"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="Info"
            android:padding="8dp"
            android:src="@drawable/k_ic_info"
            app:tint="@color/primary_teal" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/k_divider" />

    <!-- Conversation: contact intro, timestamp label, then the messages list -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/chatScroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:id="@+id/chatScrollContent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:descendantFocusability="blocksDescendants"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:paddingStart="16dp"
                android:paddingTop="14dp"
                android:paddingEnd="16dp">

                <TextView
                    android:id="@+id/chatIntroAvatar"
                    style="@style/Kinnect.Text.AvatarInitials"
                    android:layout_width="68dp"
                    android:layout_height="68dp"
                    android:background="@drawable/k_bg_circle_maroon"
                    android:text="U"
                    android:textSize="24sp" />

                <TextView
                    android:id="@+id/chatIntroNameTxt"
                    style="@style/Kinnect.Text.ToolbarTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:gravity="center"
                    android:text="Chat User" />

                <TextView
                    style="@style/Kinnect.Text.Secondary"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:gravity="center"
                    android:text="You're friends on Kinnect"
                    android:textSize="13sp" />

                <TextView
                    style="@style/Kinnect.Text.Secondary"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:layout_marginBottom="10dp"
                    android:letterSpacing="0.04"
                    android:text="TODAY 4:49 PM"
                    android:textSize="12sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/messagesRecyclerView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clipToPadding="false"
                android:nestedScrollingEnabled="false"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:paddingBottom="10dp"
                tools:listitem="@layout/item_message_incoming" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- Replying bar -->
    <LinearLayout
        android:id="@+id/replyingToMessageBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/k_bg_app"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingTop="8dp"
        android:paddingEnd="16dp"
        android:paddingBottom="8dp"
        android:visibility="gone">

        <TextView
            style="@style/Kinnect.Text.Secondary"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Replying: "
            android:textSize="13sp" />

        <TextView
            android:id="@+id/replyingMsgPreviewTxt"
            style="@style/Kinnect.Text.Body"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="Message preview"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/cancelMessageReplyBtn"
            style="@style/Kinnect.Text.Secondary"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:clickable="true"
            android:focusable="true"
            android:text="Cancel"
            android:textSize="13sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Bottom input row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/white"
        android:baselineAligned="false"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="8dp"
        android:paddingTop="8dp"
        android:paddingEnd="8dp"
        android:paddingBottom="8dp">

        <ImageView
            android:id="@+id/chatMoreBtn"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="More"
            android:padding="5dp"
            android:src="@drawable/k_ic_plus_circle"
            app:tint="@color/primary_teal" />

        <ImageView
            android:id="@+id/chatCameraBtn"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="Camera"
            android:padding="5dp"
            android:src="@drawable/k_ic_camera"
            app:tint="@color/primary_teal" />

        <ImageView
            android:id="@+id/chatGalleryBtn"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="Gallery"
            android:padding="5dp"
            android:src="@drawable/k_ic_image"
            app:tint="@color/primary_teal" />

        <ImageView
            android:id="@+id/chatMicBtn"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="Voice message"
            android:padding="5dp"
            android:src="@drawable/k_ic_mic"
            app:tint="@color/primary_teal" />

        <!-- Grey pill with the real message input and an emoji icon -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:layout_marginEnd="2dp"
            android:layout_weight="1"
            android:background="@drawable/k_bg_bubble_gray"
            android:gravity="center_vertical"
            android:minHeight="40dp"
            android:orientation="horizontal"
            android:paddingStart="14dp"
            android:paddingEnd="8dp">

            <EditText
                android:id="@+id/chatMessageInput"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@null"
                android:hint="Aa"
                android:importantForAutofill="no"
                android:inputType="textCapSentences|textMultiLine"
                android:maxLines="4"
                android:paddingTop="8dp"
                android:paddingBottom="8dp"
                android:textColor="@color/k_text_primary"
                android:textColorHint="@color/k_text_hint"
                android:textSize="16sp" />

            <ImageView
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:layout_marginStart="4dp"
                android:contentDescription="Emoji"
                android:padding="1dp"
                android:src="@drawable/k_ic_smile"
                app:tint="@color/primary_teal" />
        </LinearLayout>

        <ImageView
            android:id="@+id/chatSendBtn"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="Send"
            android:padding="6dp"
            android:src="@drawable/k_ic_like"
            app:tint="@color/primary_teal" />
    </LinearLayout>
</LinearLayout>
