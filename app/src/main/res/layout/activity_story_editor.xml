<?xml version="1.0" encoding="utf-8"?>
<!-- 10 · Story editor -->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/k_story_bg_dark"
    android:orientation="vertical"
    tools:context=".StoryEditorActivity">

    <!-- Rounded preview. FrameLayout: the tools and the text label are drawn on top of the story image. -->
    <FrameLayout
        android:id="@+id/storyFrame"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginStart="8dp"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="8dp"
        android:layout_weight="1"
        android:background="@drawable/story_k_bg_frame"
        android:clipToOutline="true"
        tools:targetApi="s">

        <ImageView
            android:id="@+id/storyPreviewImage"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="Story image, tap to change"
            android:scaleType="centerCrop"
            android:src="@drawable/landscape1" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <!-- Top tools: close (left) · add person, Aa, emoji, music, sparkle (right) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="8dp"
                android:paddingTop="10dp"
                android:paddingEnd="8dp">

                <ImageView
                    android:id="@+id/closeStoryBtn"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="@drawable/k_bg_circle_dark_translucent"
                    android:clickable="true"
                    android:contentDescription="Close"
                    android:focusable="true"
                    android:padding="9dp"
                    android:src="@drawable/k_ic_close"
                    app:tint="@color/white" />

                <Space
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1" />

                <ImageView
                    android:id="@+id/tagPeopleBtn"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="@drawable/k_bg_circle_dark_translucent"
                    android:contentDescription="Tag people"
                    android:padding="10dp"
                    android:src="@drawable/k_ic_add_friend"
                    app:tint="@color/white" />

                <TextView
                    android:id="@+id/textToolBtn"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_marginStart="6dp"
                    android:background="@drawable/k_bg_circle_dark_translucent"
                    android:gravity="center"
                    android:includeFontPadding="false"
                    android:text="Aa"
                    android:textColor="@color/white"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <ImageView
                    android:id="@+id/stickerBtn"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_marginStart="6dp"
                    android:background="@drawable/k_bg_circle_dark_translucent"
                    android:contentDescription="Stickers"
                    android:padding="10dp"
                    android:src="@drawable/k_ic_smile"
                    app:tint="@color/white" />

                <ImageView
                    android:id="@+id/musicBtn"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_marginStart="6dp"
                    android:background="@drawable/k_bg_circle_dark_translucent"
                    android:contentDescription="Music"
                    android:padding="10dp"
                    android:src="@drawable/k_ic_music"
                    app:tint="@color/white" />

                <ImageView
                    android:id="@+id/effectsBtn"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_marginStart="6dp"
                    android:background="@drawable/k_bg_circle_dark_translucent"
                    android:contentDescription="Effects"
                    android:padding="10dp"
                    android:src="@drawable/k_ic_sparkle"
                    app:tint="@color/white" />
            </LinearLayout>

            <Space
                android:layout_width="1dp"
                android:layout_height="0dp"
                android:layout_weight="3" />

            <!-- Text label: a real input styled as the rust-red tag -->
            <EditText
                android:id="@+id/storyTextInput"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="22dp"
                android:layout_marginEnd="22dp"
                android:background="@drawable/story_k_bg_label_rust"
                android:fontFamily="sans-serif-black"
                android:hint="Saturday plans"
                android:importantForAutofill="no"
                android:includeFontPadding="false"
                android:inputType="textCapSentences"
                android:maxLength="60"
                android:maxLines="2"
                android:minWidth="120dp"
                android:paddingStart="14dp"
                android:paddingTop="9dp"
                android:paddingEnd="14dp"
                android:paddingBottom="9dp"
                android:rotation="2"
                android:textColor="@color/white"
                android:textColorHint="#D9FFFFFF"
                android:textCursorDrawable="@null"
                android:textSize="21sp"
                android:textStyle="bold" />

            <Space
                android:layout_width="1dp"
                android:layout_height="0dp"
                android:layout_weight="2" />
        </LinearLayout>
    </FrameLayout>

    <!-- Bottom row: Your story · Close friends · send -->
    <LinearLayout
        android:id="@+id/bottomControls"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingTop="22dp"
        android:paddingEnd="12dp"
        android:paddingBottom="22dp">

        <LinearLayout
            android:id="@+id/shareToStoryBtn"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:background="@drawable/k_bg_pill_dark"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/storyOwnerInitials"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:background="@drawable/k_bg_circle_teal"
                android:gravity="center"
                android:includeFontPadding="false"
                android:text="JW"
                android:textColor="@color/white"
                android:textSize="9sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:includeFontPadding="false"
                android:text="Your story"
                android:textColor="@color/white"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/shareToCloseFriendsBtn"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:background="@drawable/k_bg_pill_dark"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:background="@drawable/story_k_bg_circle_bright_green"
                android:padding="5dp"
                android:src="@drawable/k_ic_star"
                app:tint="@color/white" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:includeFontPadding="false"
                android:text="Close friends"
                android:textColor="@color/white"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>

        <ImageView
            android:id="@+id/sendStoryBtn"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/k_bg_circle_teal"
            android:clickable="true"
            android:contentDescription="Share story"
            android:focusable="true"
            android:padding="11dp"
            android:src="@drawable/k_ic_arrow_right"
            app:tint="@color/white" />
    </LinearLayout>

</LinearLayout>
