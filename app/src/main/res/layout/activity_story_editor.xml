<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/black"
    tools:context=".StoryEditorActivity">

    <!-- Background Canvas -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginBottom="72dp"
        android:background="#8A9E80"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Top Left Close Button -->
    <ImageButton
        android:id="@+id/closeStoryBtn"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_margin="16dp"
        android:background="@drawable/bg_circle_grey"
        android:backgroundTint="#40000000"
        android:contentDescription="Close"
        android:padding="8dp"
        android:src="@drawable/outline_cancel_24"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:tint="@color/white" />

    <!-- Top Right Tools Row -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="16dp"
        android:orientation="horizontal"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageButton
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_marginEnd="8dp"
            android:background="@drawable/bg_circle_grey"
            android:backgroundTint="#40000000"
            android:contentDescription="Tag"
            android:padding="7dp"
            android:src="@drawable/outline_person_add_24"
            app:tint="@color/white" />

        <TextView
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_marginEnd="8dp"
            android:background="@drawable/bg_circle_grey"
            android:backgroundTint="#40000000"
            android:gravity="center"
            android:text="Aa"
            android:textColor="@color/white"
            android:textSize="14sp"
            android:textStyle="bold" />

        <ImageButton
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_marginEnd="8dp"
            android:background="@drawable/bg_circle_grey"
            android:backgroundTint="#40000000"
            android:contentDescription="Sticker"
            android:padding="7dp"
            android:src="@drawable/outline_sentiment_very_satisfied_24"
            app:tint="@color/white" />

        <ImageButton
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_marginEnd="8dp"
            android:background="@drawable/bg_circle_grey"
            android:backgroundTint="#40000000"
            android:contentDescription="Music"
            android:padding="7dp"
            android:src="@drawable/outline_music_note_2_24"
            app:tint="@color/white" />

        <ImageButton
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="@drawable/bg_circle_grey"
            android:backgroundTint="#40000000"
            android:contentDescription="Effects"
            android:padding="7dp"
            android:src="@drawable/outline_star_24"
            app:tint="@color/white" />
    </LinearLayout>

    <!-- Text Sticker Overlay in Center -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="24dp"
        android:background="@drawable/bg_rounded_teal"
        android:backgroundTint="@color/accent_rust"
        android:paddingHorizontal="16dp"
        android:paddingVertical="10dp"
        android:text="Saturday plans"
        android:textColor="@color/white"
        android:textSize="22sp"
        android:textStyle="bold"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.5" />

    <!-- Bottom Toolbar Row -->
    <LinearLayout
        android:id="@+id/bottomControls"
        android:layout_width="match_parent"
        android:layout_height="72dp"
        android:background="@color/black"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp"
        app:layout_constraintBottom_toBottomOf="parent">

        <!-- "Your story" Button -->
        <LinearLayout
            android:id="@+id/shareToStoryBtn"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_marginEnd="8dp"
            android:layout_weight="1"
            android:background="@drawable/bg_pill_gray"
            android:backgroundTint="#262626"
            android:gravity="center"
            android:orientation="horizontal"
            android:paddingHorizontal="12dp">

            <TextView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:background="@drawable/bg_circle_teal"
                android:gravity="center"
                android:text="JW"
                android:textColor="@color/white"
                android:textSize="10sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="Your story"
                android:textColor="@color/white"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- "Close friends" Button -->
        <LinearLayout
            android:id="@+id/shareToCloseFriendsBtn"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_marginEnd="12dp"
            android:layout_weight="1"
            android:background="@drawable/bg_pill_gray"
            android:backgroundTint="#262626"
            android:gravity="center"
            android:orientation="horizontal"
            android:paddingHorizontal="12dp">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:background="@drawable/bg_circle_online"
                android:contentDescription="Star"
                android:padding="3dp"
                android:src="@drawable/outline_star_24"
                app:tint="@color/white" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="Close friends"
                android:textColor="@color/white"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Next Arrow Circle Button -->
        <ImageButton
            android:id="@+id/sendStoryBtn"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/bg_circle_teal"
            android:contentDescription="Next"
            android:padding="10dp"
            android:src="@drawable/outline_arrow_right_alt_24"
            app:tint="@color/white" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>