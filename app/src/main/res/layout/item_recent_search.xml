<?xml version="1.0" encoding="utf-8"?>
<!-- 13 Search: one "Recent searches" row. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:paddingHorizontal="16dp"
    android:paddingVertical="4dp"
    android:gravity="center_vertical">

    <ImageView
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:background="@drawable/k_bg_circle_gray"
        android:padding="9dp"
        android:src="@drawable/k_ic_clock"
        android:contentDescription="Recent search"
        app:tint="@color/k_text_secondary" />

    <TextView
        android:id="@+id/recentSearchTxt"
        style="@style/Kinnect.Text.Body"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginStart="12dp"
        android:maxLines="1"
        android:ellipsize="end"
        android:text="lina marsh" />

    <ImageView
        android:id="@+id/recentSearchRemoveBtn"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:padding="3dp"
        android:src="@drawable/k_ic_close"
        android:contentDescription="Remove"
        app:tint="@color/k_text_secondary" />
</LinearLayout>
