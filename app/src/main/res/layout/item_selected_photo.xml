<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="80dp"
    android:layout_height="80dp"
    android:layout_marginEnd="8dp">

    <ImageView
        android:id="@+id/selectedPhotoImageView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:background="@drawable/bg_circle_grey"
        android:contentDescription="Selected Photo" />

    <ImageButton
        android:id="@+id/removePhotoBtn"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_gravity="top|end"
        android:background="@drawable/bg_circle_teal"
        android:backgroundTint="#80000000"
        android:padding="4dp"
        android:src="@drawable/outline_cancel_24"
        android:contentDescription="Remove Photo" />
</FrameLayout>
