<?xml version="1.0" encoding="utf-8"?>
<!-- 07 · Create post: one selected photo with its remove button -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="wrap_content"
    android:layout_height="88dp"
    android:layout_marginEnd="8dp"
    android:orientation="horizontal">

    <ImageView
        android:id="@+id/selectedPhotoImageView"
        android:layout_width="88dp"
        android:layout_height="88dp"
        android:background="@drawable/k_bg_image_rounded"
        android:contentDescription="Selected photo"
        android:scaleType="centerCrop" />

    <!-- remove button pulled over the photo's top-right corner (negative margin) -->
    <ImageButton
        android:id="@+id/removePhotoBtn"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_gravity="top"
        android:layout_marginStart="-28dp"
        android:layout_marginTop="4dp"
        android:layout_marginEnd="4dp"
        android:background="@drawable/k_bg_circle_dark_translucent"
        android:contentDescription="Remove photo"
        android:padding="6dp"
        android:scaleType="fitCenter"
        android:src="@drawable/k_ic_close"
        app:tint="@color/white" />
</LinearLayout>
