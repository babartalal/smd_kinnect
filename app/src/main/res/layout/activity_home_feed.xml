<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_warm_offwhite"
    tools:context=".HomeFeedActivity">

    <!-- Fixed Header Section -->
    <LinearLayout
        android:id="@+id/fixedTopSection"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/white"
        android:orientation="vertical"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <!-- Logo & Top Icons Row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="16dp"
            android:paddingTop="12dp"
            android:paddingBottom="8dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="kinnect"
                android:textColor="@color/primary_teal"
                android:textSize="26sp"
                android:textStyle="bold" />

            <!-- Search Icon Circle -->
            <ImageButton
                android:id="@+id/homeFeedSearchBtn"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginEnd="8dp"
                android:background="@drawable/bg_pill_gray"
                android:contentDescription="Search"
                android:padding="8dp"
                android:src="@drawable/outline_search_24"
                app:tint="@color/text_dark" />

            <!-- Chat Icon Circle with Badge '3' -->
            <FrameLayout
                android:id="@+id/homeFeedChatsBtn"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="@drawable/bg_pill_gray"
                    android:contentDescription="Chats"
                    android:padding="8dp"
                    android:src="@drawable/outline_sms_24"
                    app:tint="@color/text_dark" />

                <TextView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:layout_gravity="top|end"
                    android:background="@drawable/bg_circle_red_badge"
                    android:gravity="center"
                    android:text="3"
                    android:textColor="@color/white"
                    android:textSize="10sp"
                    android:textStyle="bold" />
            </FrameLayout>
        </LinearLayout>

        <!-- Navigation Tabs Row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:orientation="horizontal">

            <!-- Home Tab (Selected) -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:contentDescription="Home"
                    android:src="@drawable/rounded_home_24"
                    app:tint="@color/primary_teal" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="3dp"
                    android:layout_marginTop="4dp"
                    android:background="@color/primary_teal" />
            </LinearLayout>

            <!-- Friends Tab -->
            <FrameLayout
                android:id="@+id/friendsBtn"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_gravity="center"
                    android:contentDescription="Friends"
                    android:src="@drawable/rounded_group_24"
                    app:tint="@color/text_gray" />
            </FrameLayout>

            <!-- Marketplace Tab -->
            <FrameLayout
                android:id="@+id/homeFeedMarketplaceBtn"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_gravity="center"
                    android:contentDescription="Marketplace"
                    android:src="@drawable/rounded_add_business_24"
                    app:tint="@color/text_gray" />
            </FrameLayout>

            <!-- Notifications Tab (Badge '5') -->
            <FrameLayout
                android:id="@+id/homeFeedNotificationsBtn"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_gravity="center"
                    android:contentDescription="Notifications"
                    android:src="@drawable/rounded_notifications_24"
                    app:tint="@color/text_gray" />

                <TextView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:layout_gravity="top|center_horizontal"
                    android:layout_marginStart="8dp"
                    android:layout_marginTop="4dp"
                    android:background="@drawable/bg_circle_red_badge"
                    android:gravity="center"
                    android:text="5"
                    android:textColor="@color/white"
                    android:textSize="9sp"
                    android:textStyle="bold" />
            </FrameLayout>

            <!-- Menu Tab -->
            <FrameLayout
                android:id="@+id/homeFeedMenuBtn"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_gravity="center"
                    android:contentDescription="Menu"
                    android:src="@drawable/outline_menu_24"
                    app:tint="@color/text_gray" />
            </FrameLayout>
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#E0DDD7" />
    </LinearLayout>

    <!-- Scrollable Feed Area -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:fillViewport="false"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/fixedTopSection">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="32dp">

            <!-- "What's on your mind, Jacob?" Bar -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@color/white"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="16dp"
                android:paddingVertical="12dp">

                <TextView
                    android:id="@+id/userAvatar"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="@drawable/bg_circle_teal"
                    android:gravity="center"
                    android:text="JW"
                    android:textColor="@color/white"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <EditText
                    android:id="@+id/woym"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_marginStart="12dp"
                    android:layout_marginEnd="8dp"
                    android:layout_weight="1"
                    android:background="@drawable/woym_round_border"
                    android:focusable="false"
                    android:hint="What's on your mind, Jacob?"
                    android:inputType="none"
                    android:paddingHorizontal="16dp"
                    android:textColorHint="@color/text_gray"
                    android:textSize="14sp" />

                <ImageButton
                    android:id="@+id/homeFeedPhotoPickerBtn"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:background="@color/transparent"
                    android:contentDescription="Add Photo"
                    android:src="@drawable/outline_image_24"
                    app:tint="@color/primary_teal" />
            </LinearLayout>

            <!-- Horizontal Stories Section -->
            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@color/white"
                android:paddingVertical="12dp"
                android:scrollbars="none">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:paddingHorizontal="12dp">

                    <!-- Create Story Card -->
                    <androidx.cardview.widget.CardView
                        android:id="@+id/createStoryCard"
                        android:layout_width="105dp"
                        android:layout_height="170dp"
                        android:layout_marginHorizontal="4dp"
                        app:cardBackgroundColor="#E6F2F2"
                        app:cardCornerRadius="16dp"
                        app:cardElevation="0dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:orientation="vertical">

                            <FrameLayout
                                android:layout_width="match_parent"
                                android:layout_height="0dp"
                                android:layout_weight="1"
                                android:background="#D2E8E8">

                                <TextView
                                    android:layout_width="48dp"
                                    android:layout_height="48dp"
                                    android:layout_gravity="center"
                                    android:background="@drawable/bg_circle_teal"
                                    android:gravity="center"
                                    android:text="JW"
                                    android:textColor="@color/white"
                                    android:textSize="18sp"
                                    android:textStyle="bold" />
                            </FrameLayout>

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:background="@color/white"
                                android:gravity="center"
                                android:orientation="vertical"
                                android:padding="8dp">

                                <ImageView
                                    android:layout_width="28dp"
                                    android:layout_height="28dp"
                                    android:layout_marginTop="-16dp"
                                    android:background="@drawable/bg_circle_teal"
                                    android:contentDescription="Create"
                                    android:padding="4dp"
                                    android:src="@drawable/outline_add_2_24"
                                    app:tint="@color/white" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="4dp"
                                    android:text="Create story"
                                    android:textColor="@color/text_dark"
                                    android:textSize="11sp"
                                    android:textStyle="bold" />
                            </LinearLayout>
                        </LinearLayout>
                    </androidx.cardview.widget.CardView>

                    <!-- Story 1: Omar Farooq -->
                    <androidx.cardview.widget.CardView
                        android:id="@+id/storyCard2"
                        android:layout_width="105dp"
                        android:layout_height="170dp"
                        android:layout_marginHorizontal="4dp"
                        app:cardBackgroundColor="#2D3C4D"
                        app:cardCornerRadius="16dp"
                        app:cardElevation="0dp">

                        <RelativeLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:padding="8dp">

                            <TextView
                                android:id="@+id/st1Avatar"
                                android:layout_width="32dp"
                                android:layout_height="32dp"
                                android:background="@drawable/bg_circle_teal"
                                android:gravity="center"
                                android:text="OF"
                                android:textColor="@color/white"
                                android:textSize="11sp"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_alignParentBottom="true"
                                android:text="Omar Farooq"
                                android:textColor="@color/white"
                                android:textSize="11sp"
                                android:textStyle="bold" />
                        </RelativeLayout>
                    </androidx.cardview.widget.CardView>

                    <!-- Story 2: Sara Iqbal -->
                    <androidx.cardview.widget.CardView
                        android:id="@+id/viewMyStoryCard"
                        android:layout_width="105dp"
                        android:layout_height="170dp"
                        android:layout_marginHorizontal="4dp"
                        app:cardBackgroundColor="#D6B8A5"
                        app:cardCornerRadius="16dp"
                        app:cardElevation="0dp">

                        <RelativeLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:padding="8dp">

                            <TextView
                                android:id="@+id/st2Avatar"
                                android:layout_width="32dp"
                                android:layout_height="32dp"
                                android:background="@drawable/bg_circle_teal"
                                android:gravity="center"
                                android:text="SI"
                                android:textColor="@color/white"
                                android:textSize="11sp"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_alignParentBottom="true"
                                android:text="Sara Iqbal"
                                android:textColor="@color/white"
                                android:textSize="11sp"
                                android:textStyle="bold" />
                        </RelativeLayout>
                    </androidx.cardview.widget.CardView>

                    <!-- Story 3: Hamza -->
                    <androidx.cardview.widget.CardView
                        android:id="@+id/storyCard4"
                        android:layout_width="105dp"
                        android:layout_height="170dp"
                        android:layout_marginHorizontal="4dp"
                        app:cardBackgroundColor="#8AA482"
                        app:cardCornerRadius="16dp"
                        app:cardElevation="0dp">

                        <RelativeLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:padding="8dp">

                            <TextView
                                android:layout_width="32dp"
                                android:layout_height="32dp"
                                android:background="@drawable/bg_circle_teal"
                                android:gravity="center"
                                android:text="HA"
                                android:textColor="@color/white"
                                android:textSize="11sp"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_alignParentBottom="true"
                                android:text="Hamza"
                                android:textColor="@color/white"
                                android:textSize="11sp"
                                android:textStyle="bold" />
                        </RelativeLayout>
                    </androidx.cardview.widget.CardView>
                </LinearLayout>
            </HorizontalScrollView>

            <!-- Main Feed Post Container -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp">

                <LinearLayout
                    android:id="@+id/feedPost"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@color/white"
                    android:orientation="vertical"
                    android:paddingTop="12dp">

                    <!-- Post Header -->
                    <LinearLayout
                        android:id="@+id/feedPostHeader"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingHorizontal="16dp">

                        <TextView
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:background="@drawable/bg_circle_teal"
                            android:gravity="center"
                            android:text="LM"
                            android:textColor="@color/white"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="10dp"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Lina Marsh "
                                    android:textColor="@color/text_dark"
                                    android:textSize="14sp"
                                    android:textStyle="bold" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="is at "
                                    android:textColor="@color/text_dark"
                                    android:textSize="14sp" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Clifton Beach"
                                    android:textColor="@color/text_dark"
                                    android:textSize="14sp"
                                    android:textStyle="bold" />
                            </LinearLayout>

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:text="2h · 🌐"
                                android:textColor="@color/text_gray"
                                android:textSize="12sp" />
                        </LinearLayout>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:padding="8dp"
                            android:text="•••"
                            android:textColor="@color/text_gray"
                            android:textSize="14sp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:padding="8dp"
                            android:text="✕"
                            android:textColor="@color/text_gray"
                            android:textSize="14sp" />
                    </LinearLayout>

                    <!-- Post Caption -->
                    <TextView
                        android:id="@+id/feedPostCaption"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:paddingHorizontal="16dp"
                        android:paddingTop="10dp"
                        android:paddingBottom="12dp"
                        android:text="Sunset walk with the crew. Worth every grain of sand in my shoes."
                        android:textColor="@color/text_dark"
                        android:textSize="14sp" />

                    <!-- Multi-Photo Grid (Left large, Right split with +4) -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="240dp"
                        android:orientation="horizontal">

                        <FrameLayout
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:background="#D6C7B2" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_marginStart="2dp"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <FrameLayout
                                android:layout_width="match_parent"
                                android:layout_height="0dp"
                                android:layout_marginBottom="2dp"
                                android:layout_weight="1"
                                android:background="#8FA3A3" />

                            <FrameLayout
                                android:layout_width="match_parent"
                                android:layout_height="0dp"
                                android:layout_weight="1"
                                android:background="#6C6975">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_gravity="center"
                                    android:text="+4"
                                    android:textColor="@color/white"
                                    android:textSize="26sp"
                                    android:textStyle="bold" />
                            </FrameLayout>
                        </LinearLayout>
                    </LinearLayout>

                    <!-- Reactions Summary Row -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingHorizontal="16dp"
                        android:paddingVertical="10dp">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="👍❤️ Aisha and 1.2K others"
                            android:textColor="@color/text_gray"
                            android:textSize="12sp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="86 comments · 12 shares"
                            android:textColor="@color/text_gray"
                            android:textSize="12sp" />
                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="#E0DDD7" />

                    <!-- Action Buttons Bar -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="44dp"
                        android:orientation="horizontal">

                        <Button
                            android:id="@+id/likeBtn"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:background="@color/transparent"
                            android:text="Like"
                            android:textAllCaps="false"
                            android:textColor="@color/text_gray"
                            android:textSize="13sp"
                            app:icon="@drawable/outline_hand_bones_24"
                            app:iconGravity="textStart"
                            app:iconTint="@color/text_gray" />

                        <Button
                            android:id="@+id/commentBtn"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:background="@color/transparent"
                            android:text="Comment"
                            android:textAllCaps="false"
                            android:textColor="@color/text_gray"
                            android:textSize="13sp"
                            app:icon="@drawable/sharp_mode_comment_24"
                            app:iconGravity="textStart"
                            app:iconTint="@color/text_gray" />

                        <Button
                            android:id="@+id/shareBtn"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:background="@color/transparent"
                            android:text="Share"
                            android:textAllCaps="false"
                            android:textColor="@color/text_gray"
                            android:textSize="13sp"
                            app:icon="@drawable/rounded_arrow_top_right_24"
                            app:iconGravity="textStart"
                            app:iconTint="@color/text_gray" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Floating Reaction Picker Bar Overlay -->
                <LinearLayout
                    android:id="@+id/reactionPicker"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="bottom|start"
                    android:layout_marginStart="16dp"
                    android:layout_marginBottom="48dp"
                    android:background="@drawable/reaction_picker_bg"
                    android:elevation="6dp"
                    android:orientation="horizontal"
                    android:paddingHorizontal="8dp"
                    android:paddingVertical="6dp"
                    android:visibility="gone">

                    <ImageButton
                        android:id="@+id/likeReaction"
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:background="@color/transparent"
                        android:contentDescription="Like"
                        android:src="@drawable/outline_hand_bones_24"
                        app:tint="@color/primary_teal" />

                    <ImageButton
                        android:id="@+id/loveReaction"
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:background="@color/transparent"
                        android:contentDescription="Love"
                        android:src="@drawable/rounded_ecg_heart_24"
                        app:tint="@color/badge_red" />

                    <ImageButton
                        android:id="@+id/happyReaction"
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:background="@color/transparent"
                        android:contentDescription="Haha"
                        android:src="@drawable/outline_sentiment_very_satisfied_24"
                        app:tint="#F4B400" />

                    <ImageButton
                        android:id="@+id/wowReaction"
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:background="@color/transparent"
                        android:contentDescription="Wow"
                        android:src="@drawable/outline_sentiment_very_dissatisfied_24"
                        app:tint="#F4B400" />

                    <ImageButton
                        android:id="@+id/sadReaction"
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:background="@color/transparent"
                        android:contentDescription="Sad"
                        android:src="@drawable/outline_sentiment_dissatisfied_24"
                        app:tint="#F4B400" />

                    <ImageButton
                        android:id="@+id/angryReaction"
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:background="@color/transparent"
                        android:contentDescription="Angry"
                        android:src="@drawable/outline_sentiment_extremely_dissatisfied_24"
                        app:tint="#DB4437" />
                </LinearLayout>
            </FrameLayout>

        </LinearLayout>
    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>