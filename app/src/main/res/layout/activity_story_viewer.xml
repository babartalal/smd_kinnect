<?xml version="1.0" encoding="utf-8"?>
<!-- 11 · Story viewer -->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/k_story_bg_dark"
    android:orientation="vertical"
    tools:context=".StoryViewerActivity">

    <!-- Rounded story. FrameLayout: progress, author and label are drawn on top of the story image. -->
    <FrameLayout
        android:id="@+id/storyFrame"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginStart="8dp"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="8dp"
        android:layout_weight="1"
        android:background="@drawable/story_k_bg_frame"
        android:clipToOutline="true"
        tools:targetApi="s">

        <ImageView
            android:id="@+id/storyMedia"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="Story"
            android:scaleType="centerCrop"
            android:src="@drawable/landscape1" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <!-- Segmented progress: two seen, third half way, fourth pending -->
            <LinearLayout
                android:id="@+id/progressContainer"
                android:layout_width="match_parent"
                android:layout_height="3dp"
                android:layout_marginStart="10dp"
                android:layout_marginTop="9dp"
                android:layout_marginEnd="10dp"
                android:orientation="horizontal">

                <View
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@drawable/story_k_bg_progress_fill" />

                <View
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginStart="4dp"
                    android:layout_weight="1"
                    android:background="@drawable/story_k_bg_progress_fill" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginStart="4dp"
                    android:layout_weight="1"
                    android:background="@drawable/story_k_bg_progress_track"
                    android:orientation="horizontal">

                    <View
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:background="@drawable/story_k_bg_progress_fill" />

                    <Space
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1" />
                </LinearLayout>

                <View
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginStart="4dp"
                    android:layout_weight="1"
                    android:background="@drawable/story_k_bg_progress_track" />
            </LinearLayout>

            <!-- Author row -->
            <LinearLayout
                android:id="@+id/storyHeader"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="10dp"
                android:paddingTop="10dp"
                android:paddingEnd="10dp">

                <TextView
                    android:id="@+id/storyAuthorInitials"
                    style="@style/Kinnect.Text.AvatarInitials"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:background="@drawable/k_bg_circle_green"
                    android:includeFontPadding="false"
                    android:text="OF"
                    android:textSize="13sp" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/storyAuthorName"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:includeFontPadding="false"
                        android:maxLines="1"
                        android:text="Omar Farooq"
                        android:textColor="@color/white"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/storyTime"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:includeFontPadding="false"
                            android:text="5h"
                            android:textColor="#E6FFFFFF"
                            android:textSize="12sp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:includeFontPadding="false"
                            android:text=" · "
                            android:textColor="#E6FFFFFF"
                            android:textSize="12sp" />

                        <ImageView
                            android:layout_width="12dp"
                            android:layout_height="12dp"
                            android:contentDescription="Public"
                            android:src="@drawable/k_ic_globe"
                            app:tint="#E6FFFFFF" />
                    </LinearLayout>
                </LinearLayout>

                <ImageView
                    android:id="@+id/moreOptionsBtn"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:contentDescription="More"
                    android:padding="4dp"
                    android:src="@drawable/k_ic_more"
                    app:tint="@color/white" />

                <ImageView
                    android:id="@+id/closeStoryBtn"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:layout_marginStart="14dp"
                    android:clickable="true"
                    android:contentDescription="Close"
                    android:focusable="true"
                    android:padding="3dp"
                    android:src="@drawable/k_ic_close"
                    app:tint="@color/white" />
            </LinearLayout>

            <Space
                android:layout_width="1dp"
                android:layout_height="0dp"
                android:layout_weight="2" />

            <!-- Text label: white rounded tag -->
            <TextView
                android:id="@+id/storyTextLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginStart="24dp"
                android:layout_marginEnd="24dp"
                android:background="@drawable/story_k_bg_label_white"
                android:fontFamily="sans-serif-black"
                android:gravity="center"
                android:includeFontPadding="false"
                android:paddingStart="16dp"
                android:paddingTop="10dp"
                android:paddingEnd="16dp"
                android:paddingBottom="10dp"
                android:rotation="-3"
                android:text="Karachi nights"
                android:textColor="@color/k_text_primary"
                android:textSize="22sp"
                android:textStyle="bold" />

            <Space
                android:layout_width="1dp"
                android:layout_height="0dp"
                android:layout_weight="3" />
        </LinearLayout>
    </FrameLayout>

    <!-- Bottom row: message input and quick reactions -->
    <LinearLayout
        android:id="@+id/storyBottomBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingTop="22dp"
        android:paddingEnd="16dp"
        android:paddingBottom="22dp">

        <EditText
            android:id="@+id/replyInput"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:background="@drawable/story_k_bg_pill_outline_white"
            android:hint="Send message..."
            android:importantForAutofill="no"
            android:inputType="textShortMessage"
            android:maxLines="1"
            android:paddingStart="18dp"
            android:paddingEnd="18dp"
            android:textColor="@color/white"
            android:textColorHint="#99FFFFFF"
            android:textSize="15sp" />

        <ImageView
            android:id="@+id/likeStoryBtn"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_marginStart="14dp"
            android:background="@drawable/k_bg_circle_teal"
            android:contentDescription="Like"
            android:padding="7dp"
            android:src="@drawable/k_ic_like"
            app:tint="@color/white" />

        <ImageView
            android:id="@+id/likeStoryBtn2"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_marginStart="14dp"
            android:background="@drawable/story_k_bg_circle_love"
            android:contentDescription="Love"
            android:padding="7dp"
            android:src="@drawable/k_ic_heart_filled"
            app:tint="@color/white" />

        <ImageView
            android:id="@+id/shareStoryBtn"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_marginStart="14dp"
            android:background="@drawable/story_k_bg_circle_yellow"
            android:contentDescription="Haha"
            android:padding="6dp"
            android:src="@drawable/k_ic_smile"
            app:tint="@color/white" />
    </LinearLayout>

</LinearLayout>
