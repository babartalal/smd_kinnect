<?xml version="1.0" encoding="utf-8"?>
<!-- 04 · Home feed post, with the 05 · Reaction picker floating above the Like row -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/white"
    android:orientation="vertical">

    <!-- Header: avatar, name, time · globe, more, close -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingTop="12dp"
        android:paddingEnd="6dp"
        android:paddingBottom="8dp">

        <ImageView
            android:id="@+id/postAuthorAvatar"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/k_bg_circle_purple"
            android:contentDescription="Author"
            android:scaleType="centerCrop"
            android:visibility="gone" />

        <TextView
            android:id="@+id/postAuthorInitials"
            style="@style/Kinnect.Text.AvatarInitials"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/k_bg_circle_purple"
            android:text="LM"
            android:textSize="14sp" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/postAuthorName"
                style="@style/Kinnect.Text.Name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="Lina Marsh"
                android:textSize="16sp" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/postTimestamp"
                    style="@style/Kinnect.Text.Secondary"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="2h"
                    android:textSize="13sp" />

                <TextView
                    style="@style/Kinnect.Text.Secondary"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text=" · "
                    android:textSize="13sp" />

                <ImageView
                    android:layout_width="13dp"
                    android:layout_height="13dp"
                    android:contentDescription="Public"
                    android:src="@drawable/k_ic_globe"
                    app:tint="@color/k_text_secondary" />
            </LinearLayout>
        </LinearLayout>

        <ImageView
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:contentDescription="More"
            android:padding="8dp"
            android:src="@drawable/k_ic_more"
            app:tint="@color/k_text_secondary" />

        <ImageView
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:contentDescription="Hide post"
            android:padding="9dp"
            android:src="@drawable/k_ic_close"
            app:tint="@color/k_text_secondary" />
    </LinearLayout>

    <!-- Caption -->
    <TextView
        android:id="@+id/postCaption"
        style="@style/Kinnect.Text.Body"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:lineSpacingExtra="3dp"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingBottom="10dp"
        android:text="Sunset walk with the crew. Worth every grain of sand in my shoes."
        android:textSize="15sp" />

    <!-- Photo grid: only one of the four children is visible at a time -->
    <LinearLayout
        android:id="@+id/imageGridContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="gone">

        <!-- 1 photo -->
        <ImageView
            android:id="@+id/singleImageView"
            android:layout_width="match_parent"
            android:layout_height="300dp"
            android:background="@color/k_chip_gray"
            android:contentDescription="Post photo"
            android:scaleType="centerCrop"
            android:visibility="gone" />

        <!-- 2 photos -->
        <LinearLayout
            android:id="@+id/twoImageGrid"
            android:layout_width="match_parent"
            android:layout_height="240dp"
            android:orientation="horizontal"
            android:visibility="gone">

            <ImageView
                android:id="@+id/image2_1"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginEnd="2dp"
                android:layout_weight="1"
                android:background="@color/k_chip_gray"
                android:contentDescription="Post photo 1"
                android:scaleType="centerCrop" />

            <ImageView
                android:id="@+id/image2_2"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="2dp"
                android:layout_weight="1"
                android:background="@color/k_chip_gray"
                android:contentDescription="Post photo 2"
                android:scaleType="centerCrop" />
        </LinearLayout>

        <!-- 3 photos: one tall on the left, two stacked on the right -->
        <LinearLayout
            android:id="@+id/threeImageGrid"
            android:layout_width="match_parent"
            android:layout_height="240dp"
            android:orientation="horizontal"
            android:visibility="gone">

            <ImageView
                android:id="@+id/image3_1"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginEnd="2dp"
                android:layout_weight="1"
                android:background="@color/k_chip_gray"
                android:contentDescription="Post photo 1"
                android:scaleType="centerCrop" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="2dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <ImageView
                    android:id="@+id/image3_2"
                    android:layout_width="match_parent"
                    android:layout_height="118dp"
                    android:layout_marginBottom="4dp"
                    android:background="@color/k_chip_gray"
                    android:contentDescription="Post photo 2"
                    android:scaleType="centerCrop" />

                <ImageView
                    android:id="@+id/image3_3"
                    android:layout_width="match_parent"
                    android:layout_height="118dp"
                    android:background="@color/k_chip_gray"
                    android:contentDescription="Post photo 3"
                    android:scaleType="centerCrop" />
            </LinearLayout>
        </LinearLayout>

        <!-- 4+ photos: same shape, "+N" over the last photo -->
        <LinearLayout
            android:id="@+id/fourPlusImageGrid"
            android:layout_width="match_parent"
            android:layout_height="240dp"
            android:orientation="horizontal"
            android:visibility="gone">

            <ImageView
                android:id="@+id/image4_1"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginEnd="2dp"
                android:layout_weight="1"
                android:background="@color/k_chip_gray"
                android:contentDescription="Post photo 1"
                android:scaleType="centerCrop" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="2dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <ImageView
                    android:id="@+id/image4_2"
                    android:layout_width="match_parent"
                    android:layout_height="118dp"
                    android:layout_marginBottom="4dp"
                    android:background="@color/k_chip_gray"
                    android:contentDescription="Post photo 2"
                    android:scaleType="centerCrop" />

                <ImageView
                    android:id="@+id/image4_3"
                    android:layout_width="match_parent"
                    android:layout_height="118dp"
                    android:background="@color/k_chip_gray"
                    android:contentDescription="Post photo 3"
                    android:scaleType="centerCrop" />

                <!-- "+N" pulled up over the last photo with a negative margin -->
                <TextView
                    android:id="@+id/moreImagesOverlay"
                    android:layout_width="match_parent"
                    android:layout_height="118dp"
                    android:layout_marginTop="-118dp"
                    android:background="#73000000"
                    android:gravity="center"
                    android:text="+4"
                    android:textColor="@color/white"
                    android:textSize="28sp"
                    android:textStyle="bold"
                    android:visibility="gone" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <!-- Reactions summary -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingTop="10dp"
        android:paddingEnd="16dp"
        android:paddingBottom="10dp">

        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:background="@drawable/k_bg_circle_white"
            android:contentDescription="Like"
            android:padding="1.5dp"
            android:src="@drawable/feed_reaction_like" />

        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_marginStart="-6dp"
            android:background="@drawable/k_bg_circle_white"
            android:contentDescription="Love"
            android:padding="1.5dp"
            android:src="@drawable/feed_reaction_love" />

        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_marginStart="-6dp"
            android:background="@drawable/k_bg_circle_white"
            android:contentDescription="Haha"
            android:padding="1.5dp"
            android:src="@drawable/feed_reaction_haha" />

        <TextView
            android:id="@+id/reactionSummaryTxt"
            style="@style/Kinnect.Text.Secondary"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="Aisha and 1.2K others" />

        <TextView
            android:id="@+id/commentsSummaryTxt"
            style="@style/Kinnect.Text.Secondary"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="86 comments · 12 shares" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp"
        android:background="@color/k_divider" />

    <!--
        05 · Reaction picker. Negative top margin lifts it over the summary row
        (and the bottom of the photo) so it floats above the Like row without
        taking any height of its own (-58 + 52 + 6 = 0).
    -->
    <LinearLayout
        android:id="@+id/reactionPickerLayout"
        android:layout_width="wrap_content"
        android:layout_height="52dp"
        android:layout_marginStart="14dp"
        android:layout_marginTop="-58dp"
        android:layout_marginBottom="6dp"
        android:background="@drawable/feed_bg_reaction_picker"
        android:elevation="8dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/likeReaction"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_marginStart="3dp"
            android:layout_marginEnd="4dp"
            android:background="@drawable/feed_reaction_like"
            android:clickable="true"
            android:contentDescription="Like"
            android:focusable="true" />

        <TextView
            android:id="@+id/loveReaction"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_marginStart="4dp"
            android:layout_marginEnd="4dp"
            android:background="@drawable/feed_reaction_love"
            android:clickable="true"
            android:contentDescription="Love"
            android:focusable="true" />

        <TextView
            android:id="@+id/hahaReaction"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_marginStart="4dp"
            android:layout_marginEnd="4dp"
            android:background="@drawable/feed_reaction_haha"
            android:clickable="true"
            android:contentDescription="Haha"
            android:focusable="true" />

        <TextView
            android:id="@+id/wowReaction"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_marginStart="4dp"
            android:layout_marginEnd="4dp"
            android:background="@drawable/feed_reaction_wow"
            android:clickable="true"
            android:contentDescription="Wow"
            android:focusable="true" />

        <TextView
            android:id="@+id/sadReaction"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_marginStart="4dp"
            android:layout_marginEnd="4dp"
            android:background="@drawable/feed_reaction_sad"
            android:clickable="true"
            android:contentDescription="Sad"
            android:focusable="true" />

        <TextView
            android:id="@+id/angryReaction"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_marginStart="4dp"
            android:layout_marginEnd="3dp"
            android:background="@drawable/feed_reaction_angry"
            android:clickable="true"
            android:contentDescription="Angry"
            android:focusable="true" />
    </LinearLayout>

    <!-- Like / Comment / Share -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="46dp"
        android:orientation="horizontal"
        android:paddingStart="8dp"
        android:paddingEnd="8dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/likeBtn"
                style="@style/Kinnect.Text.Secondary"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:clickable="true"
                android:drawablePadding="8dp"
                android:drawableStart="@drawable/k_ic_like"
                android:drawableTint="@color/k_text_secondary"
                android:focusable="true"
                android:gravity="center_vertical"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:text="Like"
                android:textSize="15sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/commentBtn"
                style="@style/Kinnect.Text.Secondary"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:clickable="true"
                android:drawablePadding="8dp"
                android:drawableStart="@drawable/k_ic_comment"
                android:drawableTint="@color/k_text_secondary"
                android:focusable="true"
                android:gravity="center_vertical"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:text="Comment"
                android:textSize="15sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/shareBtn"
                style="@style/Kinnect.Text.Secondary"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:clickable="true"
                android:drawablePadding="8dp"
                android:drawableStart="@drawable/k_ic_share"
                android:drawableTint="@color/k_text_secondary"
                android:focusable="true"
                android:gravity="center_vertical"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:text="Share"
                android:textSize="15sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <!-- thick divider band between posts -->
    <View
        android:layout_width="match_parent"
        android:layout_height="8dp"
        android:background="@color/k_chip_gray" />
</LinearLayout>
