<?xml version="1.0" encoding="utf-8"?>
<!-- 17 Other profile -->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/white"
    tools:context=".OtherProfileActivity">

    <!-- Toolbar -->
    <LinearLayout
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="8dp"
        android:paddingEnd="16dp">

        <ImageButton
            android:id="@+id/otherProfileBackBtn"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@android:color/transparent"
            android:contentDescription="Back"
            android:src="@drawable/k_ic_back"
            app:tint="@color/k_text_primary" />

        <TextView
            android:id="@+id/otherProfileTitleName"
            style="@style/Kinnect.Text.ToolbarTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="4dp"
            android:maxLines="1"
            android:ellipsize="end"
            android:text="Omar Farooq"
            android:textSize="20sp" />

        <ImageView
            android:id="@+id/otherProfileSearchBtn"
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:src="@drawable/k_ic_search"
            android:contentDescription="Search"
            app:tint="@color/k_text_primary" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/k_divider" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="32dp">

            <!-- Cover photo -->
            <ImageView
                android:id="@+id/otherProfileCoverImage"
                android:layout_width="match_parent"
                android:layout_height="180dp"
                android:scaleType="centerCrop"
                android:src="@drawable/people_scene_cover_dark"
                android:contentDescription="Cover photo" />

            <!-- Centred avatar with teal ring overlapping the cover (negative margin). -->
            <LinearLayout
                android:layout_width="144dp"
                android:layout_height="144dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="-87dp"
                android:background="@drawable/people_bg_ring_teal"
                android:padding="6dp">

                <ImageView
                    android:id="@+id/otherProfileAvatarImage"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop"
                    android:background="@drawable/k_bg_circle_green"
                    android:contentDescription="Profile picture"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/otherProfileAvatar"
                    style="@style/Kinnect.Text.AvatarInitials"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/k_bg_circle_green"
                    android:text="OF"
                    android:textSize="48sp" />
            </LinearLayout>

            <!-- Name, friends, bio (centred) -->
            <TextView
                android:id="@+id/otherProfileNameTxt"
                style="@style/Kinnect.Text.PageTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="16dp"
                android:layout_marginTop="12dp"
                android:gravity="center_horizontal"
                android:text="Omar Farooq" />

            <TextView
                android:id="@+id/otherProfileFriendsTxt"
                style="@style/Kinnect.Text.Secondary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="16dp"
                android:layout_marginTop="8dp"
                android:gravity="center_horizontal"
                android:text="1,204 friends · 38 mutual"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/otherProfileBioTxt"
                style="@style/Kinnect.Text.Body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="16dp"
                android:layout_marginTop="8dp"
                android:gravity="center_horizontal"
                android:text="Night photographer. Karachi after dark."
                android:textSize="15sp" />

            <!-- Add friend / Message / more -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="38dp"
                android:layout_marginHorizontal="16dp"
                android:layout_marginTop="12dp"
                android:orientation="horizontal">

                <LinearLayout
                    android:id="@+id/addFriendContainer"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:layout_marginEnd="8dp"
                    android:orientation="horizontal"
                    android:gravity="center"
                    android:clickable="true"
                    android:focusable="true"
                    android:background="@drawable/k_bg_button_teal_small">

                    <ImageView
                        android:layout_width="19dp"
                        android:layout_height="19dp"
                        android:src="@drawable/k_ic_add_friend"
                        android:contentDescription="Add friend"
                        app:tint="@color/white" />

                    <TextView
                        android:id="@+id/addFriendBtn"
                        style="@style/Kinnect.Text"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:text="Add friend"
                        android:textColor="@color/white"
                        android:textSize="15sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/messageBtn"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:orientation="horizontal"
                    android:gravity="center"
                    android:clickable="true"
                    android:focusable="true"
                    android:background="@drawable/k_bg_button_gray">

                    <ImageView
                        android:layout_width="19dp"
                        android:layout_height="19dp"
                        android:src="@drawable/k_ic_messenger"
                        android:contentDescription="Message"
                        app:tint="@color/k_text_primary" />

                    <TextView
                        style="@style/Kinnect.Text"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:text="Message"
                        android:textSize="15sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <ImageView
                    android:id="@+id/otherProfileMoreBtn"
                    android:layout_width="42dp"
                    android:layout_height="match_parent"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/k_bg_button_gray"
                    android:padding="10dp"
                    android:src="@drawable/k_ic_more"
                    android:contentDescription="More"
                    app:tint="@color/k_text_primary" />
            </LinearLayout>

            <!-- Mutual friends: overlapping mini avatars (negative margins) + text -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="16dp"
                android:layout_marginTop="12dp"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    style="@style/Kinnect.Text.AvatarInitials"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:background="@drawable/k_bg_circle_maroon"
                    android:text="AK"
                    android:textSize="9sp" />

                <TextView
                    style="@style/Kinnect.Text.AvatarInitials"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:layout_marginStart="-7dp"
                    android:background="@drawable/k_bg_circle_purple"
                    android:text="LM"
                    android:textSize="9sp" />

                <TextView
                    style="@style/Kinnect.Text.AvatarInitials"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:layout_marginStart="-7dp"
                    android:background="@drawable/k_bg_circle_slate"
                    android:text="ZR"
                    android:textSize="9sp" />

                <TextView
                    android:id="@+id/otherProfileMutualTxt"
                    style="@style/Kinnect.Text.Body"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="10dp"
                    android:lineSpacingExtra="3dp"
                    android:text="Friends with Aisha Khan, Lina Marsh and 36 others"
                    android:textSize="14sp" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginHorizontal="16dp"
                android:layout_marginTop="14dp"
                android:background="@color/k_divider" />

            <!-- Details rows -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="16dp"
                android:layout_marginTop="12dp"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/k_ic_briefcase"
                    android:contentDescription="Work"
                    app:tint="@color/k_text_primary" />

                <TextView
                    style="@style/Kinnect.Text.Body"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:text="Photographer at "
                    android:textSize="15sp" />

                <TextView
                    style="@style/Kinnect.Text.Body"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Studio Nocturne"
                    android:textSize="15sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="16dp"
                android:layout_marginTop="10dp"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/k_ic_location"
                    android:contentDescription="Location"
                    app:tint="@color/k_text_primary" />

                <TextView
                    style="@style/Kinnect.Text.Body"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:text="Lives in "
                    android:textSize="15sp" />

                <TextView
                    style="@style/Kinnect.Text.Body"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Karachi, Pakistan"
                    android:textSize="15sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="16dp"
                android:layout_marginTop="10dp"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/k_ic_clock"
                    android:contentDescription="Joined"
                    app:tint="@color/k_text_primary" />

                <TextView
                    style="@style/Kinnect.Text.Body"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:text="Joined June 2017"
                    android:textSize="15sp" />
            </LinearLayout>

            <!-- Photos -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="16dp"
                android:layout_marginTop="18dp"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    style="@style/Kinnect.Text.Section"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="sans-serif-black"
                    android:text="Photos" />

                <TextView
                    android:id="@+id/otherProfileSeeAllPhotosBtn"
                    style="@style/Kinnect.Text.Link"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="See all"
                    android:textSize="15sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="104dp"
                android:layout_marginHorizontal="16dp"
                android:layout_marginTop="10dp"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:scaleType="fitXY"
                    android:src="@drawable/people_scene_tile_night"
                    android:contentDescription="Photo" />

                <ImageView
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:layout_marginStart="4dp"
                    android:scaleType="fitXY"
                    android:src="@drawable/people_scene_tile_lilac"
                    android:contentDescription="Photo" />

                <ImageView
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:layout_marginStart="4dp"
                    android:scaleType="fitXY"
                    android:src="@drawable/people_scene_tile_blue"
                    android:contentDescription="Photo" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
