<?xml version="1.0" encoding="utf-8"?>
<!-- 14 Friends: one friend-request row. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:paddingHorizontal="16dp"
    android:paddingVertical="8dp"
    android:gravity="center_vertical"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?android:attr/selectableItemBackground">

    <!-- Avatar: bindAvatar() shows exactly one of these two views. -->
    <ImageView
        android:id="@+id/requestAvatarImage"
        android:layout_width="74dp"
        android:layout_height="74dp"
        android:scaleType="centerCrop"
        android:background="@drawable/k_bg_circle_indigo"
        android:contentDescription="User avatar"
        android:visibility="gone" />

    <TextView
        android:id="@+id/requestAvatarInitials"
        style="@style/Kinnect.Text.AvatarInitials"
        android:layout_width="74dp"
        android:layout_height="74dp"
        android:background="@drawable/k_bg_circle_indigo"
        android:text="SI"
        android:textSize="26sp" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginStart="12dp"
        android:orientation="vertical">

        <!-- Name + time -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/requestNameTxt"
                style="@style/Kinnect.Text.Name"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:maxLines="1"
                android:ellipsize="end"
                android:text="Sara Iqbal"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/requestTimeTxt"
                style="@style/Kinnect.Text.Secondary"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="3d"
                android:textSize="13sp" />
        </LinearLayout>

        <!-- Two overlapping mutual avatars + count -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <View
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:background="@drawable/k_bg_circle_indigo" />

            <View
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_marginStart="-6dp"
                android:background="@drawable/k_bg_circle_brown" />

            <TextView
                android:id="@+id/mutualFriendsTxt"
                style="@style/Kinnect.Text.Secondary"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:text="8 mutual friends"
                android:textSize="13sp" />
        </LinearLayout>

        <!-- Confirm / Delete -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="7dp"
            android:orientation="horizontal">

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/confirmBtn"
                style="@style/Kinnect.Button.Teal"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_weight="1"
                android:layout_marginEnd="8dp"
                android:padding="0dp"
                android:text="Confirm"
                android:textSize="15sp" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/deleteBtn"
                style="@style/Kinnect.Button.Gray"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_weight="1"
                android:padding="0dp"
                android:text="Delete"
                android:textSize="15sp" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
