<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:paddingHorizontal="16dp"
    android:paddingVertical="8dp"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?android:attr/selectableItemBackground">

    <FrameLayout
        android:layout_width="72dp"
        android:layout_height="72dp">

        <ImageView
            android:id="@+id/requestAvatarImage"
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:scaleType="centerCrop"
            android:background="@drawable/bg_circle_teal"
            android:src="@drawable/round_account_circle_24"
            android:contentDescription="User Avatar" />

        <TextView
            android:id="@+id/requestAvatarInitials"
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:background="@drawable/bg_circle_teal"
            android:gravity="center"
            android:text="U"
            android:textColor="@color/white"
            android:textSize="24sp"
            android:textStyle="bold"
            android:visibility="gone" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:layout_marginStart="12dp"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/requestNameTxt"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="User Name"
            android:textColor="@color/black"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/mutualFriendsTxt"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="0 mutual friends"
            android:textColor="#808080"
            android:textSize="14sp"
            android:layout_marginBottom="8dp"/>

        <!-- Action Buttons Row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/confirmBtn"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_weight="1"
                android:text="Confirm"
                android:textAllCaps="false"
                android:gravity="center"
                android:textColor="@color/white"
                android:background="@drawable/bg_comment_rounded"
                android:backgroundTint="@color/primary_teal"
                android:paddingVertical="0dp"
                android:textStyle="bold"
                android:textSize="14sp"
                android:layout_marginEnd="8dp"/>

            <Button
                android:id="@+id/deleteBtn"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_weight="1"
                android:text="Delete"
                android:textAllCaps="false"
                android:gravity="center"
                android:textColor="@color/black"
                android:background="@drawable/bg_comment_rounded"
                android:paddingVertical="0dp"
                android:textStyle="bold"
                android:textSize="14sp"/>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
