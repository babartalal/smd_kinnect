<?xml version="1.0" encoding="utf-8"?>
<!-- 06 · Comments: one comment (replies are indented by CommentAdapter) -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/commentContainerLayout"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:paddingStart="16dp"
    android:paddingTop="6dp"
    android:paddingEnd="16dp"
    android:paddingBottom="6dp">

    <ImageView
        android:id="@+id/commentAuthorAvatar"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:background="@drawable/k_bg_circle_maroon"
        android:contentDescription="Author"
        android:scaleType="centerCrop"
        android:visibility="gone" />

    <TextView
        android:id="@+id/commentAuthorInitials"
        style="@style/Kinnect.Text.AvatarInitials"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:background="@drawable/k_bg_circle_maroon"
        android:text="AK"
        android:textSize="12sp" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <!-- Bubble, with the like-count pill overlapping its bottom-right corner -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="20dp"
                android:layout_marginBottom="8dp"
                android:background="@drawable/k_bg_bubble_gray"
                android:orientation="vertical"
                android:paddingStart="12dp"
                android:paddingTop="9dp"
                android:paddingEnd="14dp"
                android:paddingBottom="10dp">

                <TextView
                    android:id="@+id/commentAuthorName"
                    style="@style/Kinnect.Text.Name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Aisha Khan"
                    android:textSize="15sp" />

                <TextView
                    android:id="@+id/replyingToTagTxt"
                    style="@style/Kinnect.Text.Link"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:text="\@Lina Marsh"
                    android:textSize="15sp"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/commentText"
                    style="@style/Kinnect.Text.Body"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:lineSpacingExtra="2dp"
                    android:text="That sky is unreal. Which part of the beach was this?"
                    android:textSize="15sp" />
            </LinearLayout>

            <!-- like-count pill: negative start margin pulls it over the bubble -->
            <LinearLayout
                android:id="@+id/commentLikePill"
                android:layout_width="wrap_content"
                android:layout_height="22dp"
                android:layout_gravity="bottom"
                android:layout_marginStart="-44dp"
                android:background="@drawable/feed_bg_like_pill"
                android:elevation="2dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="3dp"
                android:paddingEnd="6dp">

                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:contentDescription="Likes"
                    android:src="@drawable/feed_reaction_like" />

                <TextView
                    android:id="@+id/commentLikesCountTxt"
                    style="@style/Kinnect.Text.Secondary"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="3dp"
                    android:maxLines="1"
                    android:text="24"
                    android:textSize="12sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Optional image under the bubble -->
        <ImageView
            android:id="@+id/commentImagePreview"
            android:layout_width="168dp"
            android:layout_height="116dp"
            android:layout_marginBottom="6dp"
            android:background="@drawable/k_bg_image_rounded"
            android:contentDescription="Attached image"
            android:scaleType="centerCrop"
            android:visibility="gone" />

        <!-- 2h  Like  Reply -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginTop="-2dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/commentTimestamp"
                style="@style/Kinnect.Text.Secondary"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="2h"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/commentLikeBtn"
                style="@style/Kinnect.Text.Secondary"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:clickable="true"
                android:focusable="true"
                android:paddingStart="12dp"
                android:paddingTop="4dp"
                android:paddingEnd="8dp"
                android:paddingBottom="4dp"
                android:text="Like"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/commentReplyBtn"
                style="@style/Kinnect.Text.Secondary"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:clickable="true"
                android:focusable="true"
                android:paddingStart="8dp"
                android:paddingTop="4dp"
                android:paddingEnd="8dp"
                android:paddingBottom="4dp"
                android:text="Reply"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
