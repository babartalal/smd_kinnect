<?xml version="1.0" encoding="utf-8"?>
<!-- 13 Search -->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/white"
    tools:context=".SearchActivity">

    <!-- Back arrow + grey pill search field -->
    <LinearLayout
        android:id="@+id/searchHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="8dp"
        android:paddingEnd="16dp"
        android:paddingTop="10dp"
        android:paddingBottom="4dp">

        <ImageButton
            android:id="@+id/searchBackBtn"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@android:color/transparent"
            android:contentDescription="Back"
            android:src="@drawable/k_ic_back"
            app:tint="@color/k_text_primary" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="38dp"
            android:layout_weight="1"
            android:layout_marginStart="2dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/k_bg_pill_gray"
            android:paddingStart="14dp"
            android:paddingEnd="6dp">

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:src="@drawable/k_ic_search"
                android:contentDescription="Search"
                app:tint="@color/k_text_secondary" />

            <EditText
                android:id="@+id/searchInput"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:background="@android:color/transparent"
                android:hint="Search"
                android:padding="0dp"
                android:singleLine="true"
                android:inputType="text"
                android:imeOptions="actionSearch"
                android:textSize="16sp"
                android:textColor="@color/k_text_primary"
                android:textColorHint="@color/k_text_hint" />

            <ImageView
                android:id="@+id/searchClearBtn"
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:layout_marginStart="6dp"
                android:background="@drawable/people_bg_circle_clear"
                android:padding="7dp"
                android:src="@drawable/k_ic_close"
                android:contentDescription="Clear search"
                app:tint="@color/white" />
        </LinearLayout>
    </LinearLayout>

    <!-- Filter chips -->
    <HorizontalScrollView
        android:id="@+id/searchFiltersScroll"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scrollbars="none"
        android:clipToPadding="false"
        android:paddingHorizontal="16dp"
        android:paddingTop="6dp"
        android:paddingBottom="10dp">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                style="@style/Kinnect.Chip.Selected"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:text="All" />

            <TextView
                style="@style/Kinnect.Chip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:text="People" />

            <TextView
                style="@style/Kinnect.Chip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:text="Posts" />

            <TextView
                style="@style/Kinnect.Chip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:text="Groups" />

            <TextView
                style="@style/Kinnect.Chip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Marketplace" />
        </LinearLayout>
    </HorizontalScrollView>

    <!-- Whose accounts to search: everyone, my friends, or pending friend requests -->
    <LinearLayout
        android:id="@+id/searchPeopleFilters"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp"
        android:paddingBottom="10dp">

        <TextView
            android:id="@+id/filterEveryoneChip"
            style="@style/Kinnect.Chip.Selected"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:clickable="true"
            android:focusable="true"
            android:text="Everyone" />

        <TextView
            android:id="@+id/filterFriendsChip"
            style="@style/Kinnect.Chip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:clickable="true"
            android:focusable="true"
            android:text="Friends" />

        <TextView
            android:id="@+id/filterRequestsChip"
            style="@style/Kinnect.Chip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:clickable="true"
            android:focusable="true"
            android:text="Requests" />
    </LinearLayout>

    <View
        android:id="@+id/headerDivider"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/k_divider" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="32dp">

            <!-- People -->
            <TextView
                style="@style/Kinnect.Text.Section"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="5dp"
                android:text="People" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/searchRecyclerView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false"
                tools:itemCount="3"
                tools:listitem="@layout/item_user_search" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/seeAllPeopleBtn"
                style="@style/Kinnect.Button.Gray"
                android:layout_width="match_parent"
                android:layout_height="36dp"
                android:layout_marginHorizontal="16dp"
                android:layout_marginTop="5dp"
                android:padding="0dp"
                android:text="See all people"
                android:textSize="15sp" />

            <!-- Groups -->
            <TextView
                style="@style/Kinnect.Text.Section"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginTop="18dp"
                android:layout_marginBottom="5dp"
                android:text="Groups" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingHorizontal="16dp"
                android:paddingVertical="7dp">

                <TextView
                    style="@style/Kinnect.Text.AvatarInitials"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="@drawable/people_bg_tile_purple"
                    android:text="OP"
                    android:textSize="17sp" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="12dp"
                    android:orientation="vertical">

                    <TextView
                        style="@style/Kinnect.Text.Name"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:maxLines="1"
                        android:ellipsize="end"
                        android:text="Omar's Photography Circle" />

                    <TextView
                        style="@style/Kinnect.Text.Secondary"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:maxLines="1"
                        android:ellipsize="end"
                        android:text="Public · 2.4K members · 10+ posts a day"
                        android:textSize="13sp" />
                </LinearLayout>

                <androidx.appcompat.widget.AppCompatButton
                    style="@style/Kinnect.Button.Teal"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:layout_marginStart="12dp"
                    android:paddingHorizontal="15dp"
                    android:paddingVertical="0dp"
                    android:text="Join"
                    android:textSize="14sp" />
            </LinearLayout>

            <!-- Recent searches -->
            <TextView
                style="@style/Kinnect.Text.Section"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="4dp"
                android:text="Recent searches" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingHorizontal="16dp"
                android:paddingVertical="4dp">

                <ImageView
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:background="@drawable/k_bg_circle_gray"
                    android:padding="9dp"
                    android:src="@drawable/k_ic_clock"
                    android:contentDescription="Recent search"
                    app:tint="@color/k_text_secondary" />

                <TextView
                    style="@style/Kinnect.Text.Body"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="12dp"
                    android:text="lina marsh" />

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:padding="3dp"
                    android:src="@drawable/k_ic_close"
                    android:contentDescription="Remove"
                    app:tint="@color/k_text_secondary" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingHorizontal="16dp"
                android:paddingVertical="4dp">

                <ImageView
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:background="@drawable/k_bg_circle_gray"
                    android:padding="9dp"
                    android:src="@drawable/k_ic_clock"
                    android:contentDescription="Recent search"
                    app:tint="@color/k_text_secondary" />

                <TextView
                    style="@style/Kinnect.Text.Body"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="12dp"
                    android:text="study desk karachi" />

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:padding="3dp"
                    android:src="@drawable/k_ic_close"
                    android:contentDescription="Remove"
                    app:tint="@color/k_text_secondary" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingHorizontal="16dp"
                android:paddingVertical="4dp">

                <ImageView
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:background="@drawable/k_bg_circle_gray"
                    android:padding="9dp"
                    android:src="@drawable/k_ic_clock"
                    android:contentDescription="Recent search"
                    app:tint="@color/k_text_secondary" />

                <TextView
                    style="@style/Kinnect.Text.Body"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="12dp"
                    android:text="SMD Class of 2026" />

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:padding="3dp"
                    android:src="@drawable/k_ic_close"
                    android:contentDescription="Remove"
                    app:tint="@color/k_text_secondary" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
