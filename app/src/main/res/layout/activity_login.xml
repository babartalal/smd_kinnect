<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/k_bg_app"
    android:fillViewport="true"
    tools:context=".LoginActivity">

    <!-- System-bar insets are applied as padding on @id/main, so the screen padding lives on the inner column -->
    <LinearLayout
        android:id="@+id/main"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingHorizontal="20dp"
            android:paddingTop="30dp"
            android:paddingBottom="26dp">

            <!-- Language selector -->
            <Spinner
                android:id="@+id/languageSpinner"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/auth_bg_spinner_chevron"
                android:backgroundTint="@color/k_text_secondary"
                android:dropDownWidth="180dp"
                android:minHeight="24dp"
                android:paddingEnd="24dp"
                tools:ignore="RtlSymmetry" />

            <!-- Logo tile -->
            <LinearLayout
                android:id="@+id/loginLogo"
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:layout_marginTop="34dp"
                android:background="@drawable/k_bg_tile_teal"
                android:gravity="center"
                android:orientation="vertical">

                <ImageView
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:contentDescription="Kinnect logo"
                    android:src="@drawable/k_ic_logo_mark" />
            </LinearLayout>

            <!-- Recent login -->
            <TextView
                android:id="@+id/recentLoginTxt"
                style="@style/Kinnect.Text.Secondary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="36dp"
                android:letterSpacing="0.06"
                android:text="RECENT LOGIN"
                android:textSize="12sp"
                android:textStyle="bold" />

            <LinearLayout
                android:id="@+id/recentLoginCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/k_bg_card_white"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="12dp"
                android:paddingVertical="12dp">

                <TextView
                    android:id="@+id/recentLoginAvatar"
                    style="@style/Kinnect.Text.AvatarInitials"
                    android:layout_width="52dp"
                    android:layout_height="52dp"
                    android:background="@drawable/k_bg_circle_teal"
                    android:text="JW"
                    android:textSize="18sp" />

                <!-- Badge overlaps the avatar's top-right corner (negative margin) -->
                <TextView
                    style="@style/Kinnect.Text.Badge"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_gravity="top"
                    android:layout_marginStart="-16dp"
                    android:layout_marginTop="-2dp"
                    android:text="2" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/recentLoginName"
                        style="@style/Kinnect.Text.Name"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:singleLine="true"
                        android:text="Jacob West" />

                    <TextView
                        style="@style/Kinnect.Text.Secondary"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="Tap to log in" />
                </LinearLayout>

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_marginStart="8dp"
                    android:layout_marginEnd="4dp"
                    android:contentDescription="More"
                    android:src="@drawable/k_ic_more"
                    app:tint="@color/k_text_secondary" />
            </LinearLayout>

            <!-- Mobile number or email -->
            <LinearLayout
                android:id="@+id/usernameCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:background="@drawable/k_bg_input"
                android:orientation="vertical"
                android:paddingHorizontal="14dp"
                android:paddingVertical="9dp">

                <TextView
                    style="@style/Kinnect.Text.Secondary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Mobile number or email"
                    android:textSize="12sp" />

                <EditText
                    android:id="@+id/loginEmailInput"
                    style="@style/Kinnect.Text.Body"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:background="@null"
                    android:importantForAutofill="no"
                    android:inputType="textEmailAddress"
                    android:minHeight="24dp"
                    android:padding="0dp"
                    android:singleLine="true" />
            </LinearLayout>

            <!-- Password -->
            <LinearLayout
                android:id="@+id/passwordCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/k_bg_input"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="14dp"
                android:paddingEnd="8dp"
                android:paddingVertical="9dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        style="@style/Kinnect.Text.Secondary"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Password"
                        android:textSize="12sp" />

                    <EditText
                        android:id="@+id/loginPasswordInput"
                        style="@style/Kinnect.Text.Body"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:background="@null"
                        android:importantForAutofill="no"
                        android:inputType="textPassword"
                        android:minHeight="24dp"
                        android:padding="0dp"
                        android:singleLine="true" />
                </LinearLayout>

                <ImageView
                    android:id="@+id/loginPasswordToggle"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:clickable="true"
                    android:contentDescription="Show password"
                    android:focusable="true"
                    android:padding="8dp"
                    android:src="@drawable/k_ic_eye"
                    app:tint="@color/k_text_secondary" />
            </LinearLayout>

            <!-- Log in -->
            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/loginBtn"
                style="@style/Kinnect.Button.Primary"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="12dp"
                android:text="Log in" />

            <TextView
                android:id="@+id/forgotPasswordLink"
                style="@style/Kinnect.Text.Link"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:clickable="true"
                android:focusable="true"
                android:padding="12dp"
                android:text="Forgot password?"
                android:textSize="15sp" />

            <!-- Pushes the create-account pill and footer to the bottom of the screen -->
            <View
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:minHeight="32dp" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/createNewAccBtn"
                style="@style/Kinnect.Button.Outline"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:text="Create new account"
                android:textSize="16sp" />

            <!-- Footer -->
            <LinearLayout
                android:id="@+id/footer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/k_ic_logo_mark"
                    app:tint="@color/k_text_secondary" />

                <TextView
                    style="@style/Kinnect.Text.Secondary"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:text="Kinnect · from SMD"
                    android:textSize="12sp" />
            </LinearLayout>

        </LinearLayout>
    </LinearLayout>

</ScrollView>
