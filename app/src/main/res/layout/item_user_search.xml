<?xml version="1.0" encoding="utf-8"?>
<!-- 13 Search: one person row (also used for the friends list on 14 Friends). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:paddingHorizontal="16dp"
    android:paddingVertical="7dp"
    android:gravity="center_vertical"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?android:attr/selectableItemBackground">

    <!-- Avatar: bindAvatar() shows exactly one of these two views. -->
    <ImageView
        android:id="@+id/userAvatarImage"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:scaleType="centerCrop"
        android:background="@drawable/k_bg_circle_green"
        android:contentDescription="User avatar"
        android:visibility="gone" />

    <TextView
        android:id="@+id/userAvatarInitials"
        style="@style/Kinnect.Text.AvatarInitials"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:background="@drawable/k_bg_circle_green"
        android:text="OF"
        android:textSize="17sp" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginStart="12dp"
        android:orientation="vertical">

        <TextView
            android:id="@+id/userNameTxt"
            style="@style/Kinnect.Text.Name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:ellipsize="end"
            android:text="Omar Farooq" />

        <TextView
            android:id="@+id/userInfoTxt"
            style="@style/Kinnect.Text.Secondary"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:maxLines="1"
            android:ellipsize="end"
            android:text="Friend · Lives in Karachi"
            android:textSize="13sp" />
    </LinearLayout>

    <!-- Round add-friend button; UserAdapter swaps it to a text pill for other states. -->
    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/actionBtn"
        style="@style/Kinnect.Button"
        android:layout_width="wrap_content"
        android:layout_height="38dp"
        android:layout_marginStart="12dp"
        android:minWidth="38dp"
        android:paddingHorizontal="14dp"
        android:paddingVertical="0dp"
        android:background="@drawable/people_bg_add_friend_round"
        android:textColor="@color/primary_teal"
        android:textSize="14sp"
        android:contentDescription="Add friend" />
</LinearLayout>
