<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:baselineAligned="false"
    android:clipChildren="false"
    android:gravity="start|bottom"
    android:orientation="horizontal"
    android:paddingTop="1dp"
    android:paddingBottom="2dp">

    <!-- small sender avatar, shown on the last bubble of a group (MessageAdapter) -->
    <TextView
        android:id="@+id/incomingAvatarInitials"
        style="@style/Kinnect.Text.AvatarInitials"
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:layout_gravity="bottom"
        android:layout_marginEnd="8dp"
        android:background="@drawable/k_bg_circle_maroon"
        android:text="U"
        android:textSize="10sp" />

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:clipChildren="false"
        android:gravity="start"
        android:orientation="vertical">

        <!-- Quoted reply: caption + smaller grey bubble above the message -->
        <TextView
            android:id="@+id/replyCaptionTxt"
            style="@style/Kinnect.Text.Secondary"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:layout_marginTop="8dp"
            android:layout_marginEnd="2dp"
            android:layout_marginBottom="4dp"
            android:text="You replied"
            android:textSize="12sp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/replyBubbleTxt"
            style="@style/Kinnect.Text.Secondary"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="2dp"
            android:background="@drawable/hub_bg_bubble_reply"
            android:ellipsize="end"
            android:maxWidth="240dp"
            android:maxLines="2"
            android:paddingStart="12dp"
            android:paddingTop="7dp"
            android:paddingEnd="12dp"
            android:paddingBottom="7dp"
            android:text="Replied message"
            android:visibility="gone" />

        <!-- Attached image as a rounded tile -->
        <ImageView
            android:id="@+id/messageImageView"
            android:layout_width="200dp"
            android:layout_height="140dp"
            android:layout_marginBottom="3dp"
            android:background="@drawable/k_bg_image_rounded"
            android:contentDescription="Message image"
            android:scaleType="centerCrop"
            android:visibility="gone" />

        <!-- Bubble; the heart badge overlaps its bottom corner (negative top margin) -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:clipChildren="false"
            android:orientation="vertical">

            <TextView
                android:id="@+id/messageBodyTxt"
                style="@style/Kinnect.Text.Body"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:background="@drawable/k_bg_bubble_gray"
                android:lineSpacingExtra="2dp"
                android:maxWidth="250dp"
                android:paddingStart="14dp"
                android:paddingTop="9dp"
                android:paddingEnd="14dp"
                android:paddingBottom="9dp"
                android:text="Message"
                android:textColor="@color/k_text_primary" />

            <LinearLayout
                android:id="@+id/heartReactionBadge"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_gravity="end"
                android:layout_marginTop="-10dp"
                android:background="@drawable/k_bg_circle_white"
                android:elevation="2dp"
                android:padding="3dp"
                android:visibility="gone">

                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/k_bg_circle_white"
                    android:backgroundTint="@color/k_reaction_love"
                    android:contentDescription="Loved"
                    android:padding="3dp"
                    android:src="@drawable/k_ic_heart_filled"
                    app:tint="@color/white" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/editedLabelTxt"
                style="@style/Kinnect.Text.Secondary"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:layout_marginTop="2dp"
                android:layout_marginEnd="6dp"
                android:text="Edited"
                android:textColor="@color/k_text_hint"
                android:textSize="11sp"
                android:visibility="gone" />

            <!-- The design shows no per-message time; kept (hidden) for MessageAdapter. -->
            <TextView
                android:id="@+id/messageTimeTxt"
                style="@style/Kinnect.Text.Secondary"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:layout_marginEnd="6dp"
                android:text="12:00 PM"
                android:textColor="@color/k_text_hint"
                android:textSize="11sp"
                android:visibility="gone" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
