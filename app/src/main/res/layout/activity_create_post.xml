<?xml version="1.0" encoding="utf-8"?>
<!-- 07 · Create post -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    android:orientation="vertical"
    tools:context=".CreatePostActivity">

    <!-- Toolbar: close, title, Post -->
    <LinearLayout
        android:id="@+id/createPostHeader"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="6dp"
        android:paddingEnd="12dp">

        <ImageButton
            android:id="@+id/createPostbackBtn"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@color/transparent"
            android:contentDescription="Close"
            android:padding="10dp"
            android:scaleType="fitCenter"
            android:src="@drawable/k_ic_close"
            app:tint="@color/k_text_primary" />

        <TextView
            style="@style/Kinnect.Text.ToolbarTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:layout_weight="1"
            android:text="Create post" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/postBtn"
            style="@style/Kinnect.Button.Primary"
            android:layout_width="wrap_content"
            android:layout_height="34dp"
            android:paddingStart="18dp"
            android:paddingEnd="18dp"
            android:text="Post"
            android:textSize="15sp" />
    </LinearLayout>

    <View
        android:id="@+id/headerDivider"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/k_divider" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Author row: avatar, name, Public / Album chips -->
            <LinearLayout
                android:id="@+id/userInfoRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="16dp"
                android:paddingTop="14dp"
                android:paddingEnd="16dp"
                android:paddingBottom="8dp">

                <ImageView
                    android:id="@+id/createPostAvatar"
                    android:layout_width="46dp"
                    android:layout_height="46dp"
                    android:background="@drawable/k_bg_circle_teal"
                    android:contentDescription="Your profile"
                    android:scaleType="centerCrop"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/createPostInitials"
                    style="@style/Kinnect.Text.AvatarInitials"
                    android:layout_width="46dp"
                    android:layout_height="46dp"
                    android:background="@drawable/k_bg_circle_teal"
                    android:text="JW" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/createPostUserName"
                        style="@style/Kinnect.Text.Name"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Jacob West"
                        android:textSize="16sp" />

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:orientation="horizontal">

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="26dp"
                            android:background="@drawable/feed_bg_chip_outline"
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:paddingStart="8dp"
                            android:paddingEnd="6dp">

                            <ImageView
                                android:layout_width="14dp"
                                android:layout_height="14dp"
                                android:contentDescription="Audience"
                                android:src="@drawable/k_ic_globe"
                                app:tint="@color/primary_teal" />

                            <TextView
                                style="@style/Kinnect.Text.Link"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="4dp"
                                android:text="Public"
                                android:textSize="13sp" />

                            <ImageView
                                android:layout_width="14dp"
                                android:layout_height="14dp"
                                android:layout_marginStart="3dp"
                                android:contentDescription="Change audience"
                                android:src="@drawable/k_ic_chevron_down"
                                app:tint="@color/primary_teal" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="26dp"
                            android:layout_marginStart="6dp"
                            android:background="@drawable/feed_bg_chip_outline"
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:paddingStart="8dp"
                            android:paddingEnd="6dp">

                            <ImageView
                                android:layout_width="14dp"
                                android:layout_height="14dp"
                                android:contentDescription="Album"
                                android:src="@drawable/k_ic_plus"
                                app:tint="@color/primary_teal" />

                            <TextView
                                style="@style/Kinnect.Text.Link"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="4dp"
                                android:text="Album"
                                android:textSize="13sp" />

                            <ImageView
                                android:layout_width="14dp"
                                android:layout_height="14dp"
                                android:layout_marginStart="3dp"
                                android:contentDescription="Choose album"
                                android:src="@drawable/k_ic_chevron_down"
                                app:tint="@color/primary_teal" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <!-- The post text -->
            <EditText
                android:id="@+id/postInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@color/transparent"
                android:gravity="top|start"
                android:hint="What's on your mind?"
                android:importantForAutofill="no"
                android:inputType="textCapSentences|textMultiLine"
                android:lineSpacingExtra="4dp"
                android:minHeight="96dp"
                android:paddingStart="16dp"
                android:paddingTop="8dp"
                android:paddingEnd="16dp"
                android:paddingBottom="8dp"
                android:textColor="@color/k_text_primary"
                android:textColorHint="@color/k_text_hint"
                android:textSize="22sp" />

            <!-- Background colour swatches (sample content) -->
            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:scrollbars="none">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:paddingStart="16dp"
                    android:paddingTop="8dp"
                    android:paddingEnd="16dp"
                    android:paddingBottom="12dp">

                    <TextView
                        style="@style/Kinnect.Text"
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:background="@drawable/feed_bg_swatch_outline"
                        android:gravity="center"
                        android:text="Aa"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <View
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:layout_marginStart="7dp"
                        android:background="@drawable/feed_bg_swatch"
                        android:backgroundTint="@color/primary_teal" />

                    <View
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:layout_marginStart="7dp"
                        android:background="@drawable/feed_bg_swatch"
                        android:backgroundTint="@color/k_badge_red" />

                    <View
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:layout_marginStart="7dp"
                        android:background="@drawable/feed_bg_swatch"
                        android:backgroundTint="@color/k_avatar_indigo" />

                    <View
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:layout_marginStart="7dp"
                        android:background="@drawable/feed_bg_swatch"
                        android:backgroundTint="@color/k_avatar_green" />

                    <View
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:layout_marginStart="7dp"
                        android:background="@drawable/feed_bg_swatch"
                        android:backgroundTint="@color/k_reaction_yellow" />

                    <View
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:layout_marginStart="7dp"
                        android:background="@drawable/feed_bg_swatch"
                        android:backgroundTint="@color/k_avatar_purple" />

                    <View
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:layout_marginStart="7dp"
                        android:background="@drawable/feed_bg_swatch"
                        android:backgroundTint="@color/k_text_primary" />
                </LinearLayout>
            </HorizontalScrollView>

            <!-- Selected photos -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/selectedPhotosRecyclerView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clipToPadding="false"
                android:orientation="horizontal"
                android:paddingStart="16dp"
                android:paddingEnd="8dp"
                android:paddingBottom="12dp"
                android:visibility="gone"
                app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager" />
        </LinearLayout>
    </ScrollView>

    <!-- Bottom sheet: rounded top corners, handle, options -->
    <LinearLayout
        android:id="@+id/attachmentsMenu"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/feed_bg_bottom_sheet"
        android:elevation="16dp"
        android:orientation="vertical"
        android:paddingBottom="8dp">

        <View
            android:layout_width="38dp"
            android:layout_height="4dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="8dp"
            android:background="@drawable/k_bg_pill_gray"
            android:backgroundTint="@color/k_divider" />

        <LinearLayout
            android:id="@+id/pickPhotoCreatePost"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="20dp"
            android:paddingEnd="20dp">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:contentDescription="Photo/video"
                android:src="@drawable/k_ic_image"
                app:tint="@color/k_avatar_green" />

            <TextView
                style="@style/Kinnect.Text.Body"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:text="Photo/video" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="20dp"
            android:paddingEnd="20dp">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:contentDescription="Tag people"
                android:src="@drawable/k_ic_tag"
                app:tint="@color/k_avatar_slate" />

            <TextView
                style="@style/Kinnect.Text.Body"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:text="Tag people" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="20dp"
            android:paddingEnd="20dp">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:contentDescription="Feeling/activity"
                android:src="@drawable/k_ic_smile"
                app:tint="@color/k_reaction_yellow" />

            <TextView
                style="@style/Kinnect.Text.Body"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:text="Feeling/activity" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="20dp"
            android:paddingEnd="20dp">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:contentDescription="Check in"
                android:src="@drawable/k_ic_location"
                app:tint="@color/k_badge_red" />

            <TextView
                style="@style/Kinnect.Text.Body"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:text="Check in" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="20dp"
            android:paddingEnd="20dp">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:contentDescription="Live video"
                android:src="@drawable/k_ic_video"
                app:tint="@color/k_avatar_maroon" />

            <TextView
                style="@style/Kinnect.Text.Body"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:text="Live video" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/openCamera"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="20dp"
            android:paddingEnd="20dp">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:contentDescription="Camera"
                android:src="@drawable/k_ic_camera"
                app:tint="@color/primary_teal" />

            <TextView
                style="@style/Kinnect.Text.Body"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:text="Camera" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="20dp"
            android:paddingEnd="20dp">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:contentDescription="Create event"
                android:src="@drawable/k_ic_calendar"
                app:tint="@color/k_avatar_indigo" />

            <TextView
                style="@style/Kinnect.Text.Body"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:text="Create event" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
