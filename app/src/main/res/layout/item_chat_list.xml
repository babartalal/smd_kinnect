<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?android:attr/selectableItemBackground"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="16dp"
    android:paddingTop="5dp"
    android:paddingEnd="16dp"
    android:paddingBottom="5dp">

    <!--
        Avatar: only one of image / initials is visible at a time (bindAvatar),
        and the online dot overlaps the bottom-right corner with a negative margin.
    -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:baselineAligned="false"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/chatAvatarImage"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:background="@drawable/k_bg_circle_gray"
            android:contentDescription="Avatar"
            android:scaleType="centerCrop"
            android:visibility="gone" />

        <TextView
            android:id="@+id/chatAvatarInitials"
            style="@style/Kinnect.Text.AvatarInitials"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:background="@drawable/k_bg_circle_maroon"
            android:text="U"
            android:textSize="20sp" />

        <View
            android:id="@+id/chatOnlineDot"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_gravity="bottom"
            android:layout_marginStart="-16dp"
            android:background="@drawable/k_bg_online_dot"
            android:visibility="gone" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/chatRecipientName"
            style="@style/Kinnect.Text.Name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="Recipient Name" />

        <TextView
            android:id="@+id/chatLastMessage"
            style="@style/Kinnect.Text.Secondary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="Last message · 2m" />
    </LinearLayout>

    <View
        android:id="@+id/chatUnreadBadge"
        android:layout_width="12dp"
        android:layout_height="12dp"
        android:layout_marginStart="10dp"
        android:background="@drawable/k_bg_unread_dot"
        android:visibility="gone" />
</LinearLayout>
