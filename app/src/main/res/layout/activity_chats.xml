<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    android:focusableInTouchMode="true"
    android:orientation="vertical"
    tools:context=".ChatsActivity">

    <!-- Top bar: back, title, compose -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="10dp"
        android:paddingTop="8dp"
        android:paddingEnd="16dp"
        android:paddingBottom="4dp">

        <ImageView
            android:id="@+id/chatsBackBtn"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="Back"
            android:padding="6dp"
            android:src="@drawable/k_ic_back"
            app:tint="@color/k_text_primary" />

        <TextView
            style="@style/Kinnect.Text.PageTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:text="Chats" />

        <ImageView
            android:id="@+id/chatsComposeBtn"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/k_bg_circle_gray"
            android:contentDescription="New message"
            android:padding="10dp"
            android:src="@drawable/k_ic_pencil"
            app:tint="@color/k_text_primary" />
    </LinearLayout>

    <!-- Search pill -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:layout_marginStart="16dp"
        android:layout_marginTop="6dp"
        android:layout_marginEnd="16dp"
        android:background="@drawable/k_bg_pill_gray"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="14dp"
        android:paddingEnd="14dp">

        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:importantForAccessibility="no"
            android:src="@drawable/k_ic_search"
            app:tint="@color/k_text_secondary" />

        <EditText
            android:id="@+id/chatsSearchInput"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:background="@null"
            android:hint="Search"
            android:imeOptions="actionSearch"
            android:importantForAutofill="no"
            android:inputType="text"
            android:maxLines="1"
            android:padding="0dp"
            android:textColor="@color/k_text_primary"
            android:textColorHint="@color/k_text_hint"
            android:textSize="16sp" />
    </LinearLayout>

    <!-- Notes / active people row -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingStart="10dp"
            android:paddingEnd="10dp">

            <LinearLayout
                android:layout_width="68dp"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:orientation="vertical">

                <ImageView
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:background="@drawable/k_bg_circle_gray"
                    android:contentDescription="Your note"
                    android:padding="16dp"
                    android:src="@drawable/k_ic_plus"
                    app:tint="@color/k_text_primary" />

                <TextView
                    style="@style/Kinnect.Text.Secondary"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="Your note"
                    android:textSize="13sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="68dp"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:orientation="vertical">

                <!-- avatar with a green online dot overlapping its bottom-right (negative margin) -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:baselineAligned="false"
                    android:orientation="horizontal">

                    <TextView
                        style="@style/Kinnect.Text.AvatarInitials"
                        android:layout_width="56dp"
                        android:layout_height="56dp"
                        android:background="@drawable/k_bg_circle_maroon"
                        android:text="AK"
                        android:textSize="20sp" />

                    <View
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:layout_gravity="bottom"
                        android:layout_marginStart="-16dp"
                        android:background="@drawable/k_bg_online_dot" />
                </LinearLayout>

                <TextView
                    style="@style/Kinnect.Text.Body"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="Aisha"
                    android:textSize="13sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="68dp"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:orientation="vertical">

                <!-- avatar with a green online dot overlapping its bottom-right (negative margin) -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:baselineAligned="false"
                    android:orientation="horizontal">

                    <TextView
                        style="@style/Kinnect.Text.AvatarInitials"
                        android:layout_width="56dp"
                        android:layout_height="56dp"
                        android:background="@drawable/k_bg_circle_green"
                        android:text="OF"
                        android:textSize="20sp" />

                    <View
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:layout_gravity="bottom"
                        android:layout_marginStart="-16dp"
                        android:background="@drawable/k_bg_online_dot" />
                </LinearLayout>

                <TextView
                    style="@style/Kinnect.Text.Body"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="Omar"
                    android:textSize="13sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="68dp"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:orientation="vertical">

                <!-- avatar with a green online dot overlapping its bottom-right (negative margin) -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:baselineAligned="false"
                    android:orientation="horizontal">

                    <TextView
                        style="@style/Kinnect.Text.AvatarInitials"
                        android:layout_width="56dp"
                        android:layout_height="56dp"
                        android:background="@drawable/k_bg_circle_indigo"
                        android:text="SI"
                        android:textSize="20sp" />

                    <View
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:layout_gravity="bottom"
                        android:layout_marginStart="-16dp"
                        android:background="@drawable/k_bg_online_dot" />
                </LinearLayout>

                <TextView
                    style="@style/Kinnect.Text.Body"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="Sara"
                    android:textSize="13sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="68dp"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:orientation="vertical">

                <!-- avatar with a green online dot overlapping its bottom-right (negative margin) -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:baselineAligned="false"
                    android:orientation="horizontal">

                    <TextView
                        style="@style/Kinnect.Text.AvatarInitials"
                        android:layout_width="56dp"
                        android:layout_height="56dp"
                        android:background="@drawable/k_bg_circle_brown"
                        android:text="HA"
                        android:textSize="20sp" />

                    <View
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:layout_gravity="bottom"
                        android:layout_marginStart="-16dp"
                        android:background="@drawable/k_bg_online_dot" />
                </LinearLayout>

                <TextView
                    style="@style/Kinnect.Text.Body"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="Hamza"
                    android:textSize="13sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="68dp"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:orientation="vertical">

                <!-- avatar with a green online dot overlapping its bottom-right (negative margin) -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:baselineAligned="false"
                    android:orientation="horizontal">

                    <TextView
                        style="@style/Kinnect.Text.AvatarInitials"
                        android:layout_width="56dp"
                        android:layout_height="56dp"
                        android:background="@drawable/k_bg_circle_purple"
                        android:text="LM"
                        android:textSize="20sp" />

                    <View
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:layout_gravity="bottom"
                        android:layout_marginStart="-16dp"
                        android:background="@drawable/k_bg_online_dot" />
                </LinearLayout>

                <TextView
                    style="@style/Kinnect.Text.Body"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="Lina"
                    android:textSize="13sp" />
            </LinearLayout>
        </LinearLayout>
    </HorizontalScrollView>

    <!-- Conversations -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/chatsRecyclerView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="10dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingBottom="8dp"
        tools:listitem="@layout/item_chat_list" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/k_divider" />

    <!-- Bottom tab bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/white"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingTop="8dp"
            android:paddingBottom="8dp">

            <ImageView
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:importantForAccessibility="no"
                android:src="@drawable/k_ic_messenger"
                app:tint="@color/primary_teal" />

            <TextView
                style="@style/Kinnect.Text.Body"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:fontFamily="sans-serif-medium"
                android:text="Chats"
                android:textColor="@color/primary_teal"
                android:textSize="13sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingTop="8dp"
            android:paddingBottom="8dp">

            <ImageView
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:importantForAccessibility="no"
                android:src="@drawable/k_ic_friends"
                app:tint="@color/k_text_secondary" />

            <TextView
                style="@style/Kinnect.Text.Body"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:fontFamily="sans-serif-medium"
                android:text="People"
                android:textColor="@color/k_text_secondary"
                android:textSize="13sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingTop="8dp"
            android:paddingBottom="8dp">

            <ImageView
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:importantForAccessibility="no"
                android:src="@drawable/k_ic_reels"
                app:tint="@color/k_text_secondary" />

            <TextView
                style="@style/Kinnect.Text.Body"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:fontFamily="sans-serif-medium"
                android:text="Stories"
                android:textColor="@color/k_text_secondary"
                android:textSize="13sp" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
